## Internet observatory, the map as one file: asks for a domain, surveys
## it (survey.nexo) and writes map.html, a page that needs nothing else.
##     nexo map.nexo    asks for a domain and writes map.html
## site.nexo serves the same page as a website, for any domain.
policy:
    allow net "cloudflare-dns.com", "dns.google", "stat.ripe.net", "atlas.ripe.net", "api.ioda.inetintel.cc.gatech.edu"
    allow net "www.submarinecablemap.com", "www.peeringdb.com", "crt.sh"
    allow read "site", "data", "observatory.db"
    allow write "map.html", "observatory.db"
    allow env "RIPE_ATLAS_KEY"

use survey

choice = input("Domain: ").trim().lower()
if choice == "":
    print("Nothing to trace: give a domain (example.com).")
elif not survey.valid(choice):
    print("\"{choice}\" is not a domain name. Give one like example.com.")
else:
    try:
        written = survey.page(survey.trace(choice))
        print("Written {written}")
    else e:
        print("No map: {e.message}")

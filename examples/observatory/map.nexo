## Internet observatory, the map: where a domain's names and addresses
## are, what answers for it, which networks carry its route, and where
## the internet has an outage right now, drawn over the submarine cables.
##     nexo map.nexo         asks for a domain and writes map.html
##     nexo test map.nexo    the parts that read the answers
## Every figure is asked when the program runs: DNS to a resolver over
## HTTPS, places, networks and routes to RIPEstat, outages to IODA and the
## cables to the Submarine Cable Map. What nobody publishes is not shown:
## there is no public feed of cable faults, so a cable is only marked
## when it lands in a country with an outage signal.
policy:
    allow net "cloudflare-dns.com", "stat.ripe.net", "api.ioda.inetintel.cc.gatech.edu", "www.submarinecablemap.com"
    allow read "map.template.html", "data"
    allow write "map.html"

RESOLVER = "https://cloudflare-dns.com/dns-query"
RIPE = "https://stat.ripe.net/data"
IODA = "https://api.ioda.inetintel.cc.gatech.edu/v2/outages/alerts"
CABLES = "https://www.submarinecablemap.com/api/v3"

## What tells that an answer came through an edge (a CDN, a cache or a
## web firewall) and not straight from the server: a header, a text its
## value holds ("" for any) and who sends it.
EDGES = [
    ["cf-ray", "", "Cloudflare"],
    ["x-amz-cf-id", "", "Amazon CloudFront"],
    ["x-fastly-request-id", "", "Fastly"],
    ["x-served-by", "cache-", "Fastly"],
    ["x-akamai-transformed", "", "Akamai"],
    ["x-azure-ref", "", "Azure Front Door"],
    ["x-vercel-id", "", "Vercel"],
    ["x-nf-request-id", "", "Netlify"],
    ["x-sucuri-id", "", "Sucuri firewall"],
    ["x-iinfo", "", "Imperva firewall"],
    ["server", "cloudflare", "Cloudflare"],
    ["server", "cloudfront", "Amazon CloudFront"],
    ["server", "akamai", "Akamai"],
    ["server", "varnish", "a Varnish cache"],
    ["server", "ats", "an Apache Traffic Server cache"],
    ["via", "", "a proxy"],
    ["x-cache", "", "a cache"]
]

## The zones a name is under, from the root down: "en.wikipedia.org" is
## under ".", "org", "wikipedia.org" and itself.
fn zones_of(domain: str) -> list:
    labels = domain.split(".")
    var zones = ["."]
    var zone = ""
    for i in range(len(labels)):
        label = labels[len(labels) - 1 - i]
        if zone == "":
            zone = label
        else:
            zone = "{label}.{zone}"
        zones.add(zone)
    return zones

## A name as DNS writes it in an answer, without its last dot.
fn bare(name: str) -> str:
    if name.ends_with(".") and len(name) > 1:
        return name.replace(".", " ").trim().replace(" ", ".")
    return name

## The answers of one question to the resolver (RFC 8484, as JSON).
fn ask_dns(name: str, kind: str) -> list!:
    r = http.get("{RESOLVER}?name={name}&type={kind}", headers: {"accept": "application/dns-json"}, timeout: 15s)?
    return r.json()?["Answer"] ?? []

## The records of one type (1 is A, 2 is NS, 5 is CNAME, 28 is AAAA).
fn records(answers: list, kind: int) -> list:
    return [bare(a["data"]) for a in answers if a["type"] == kind]

## The name servers of each zone the domain is under; a name that is not
## a zone of its own has none and is left out.
fn delegation(domain: str) -> list:
    var steps = []
    for zone in zones_of(domain):
        try:
            servers = records(ask_dns(zone, "NS"), 2)
            if len(servers) > 0:
                steps.add({"zone": zone, "servers": servers})
        else e:
            steps.add({"zone": zone, "servers": [], "error": e.message})
    return steps

## One data call of RIPEstat.
fn ripe(call: str, resource: str) -> map!:
    r = http.get("{RIPE}/{call}/data.json?resource={resource}", timeout: 30s)?
    return r.json()?["data"]

## The holder of a network, by its number.
fn holder_of(asn: str) -> str:
    try:
        return ripe("as-overview", "AS{asn}")["holder"] ?? ""
    else e:
        return ""

## Where an address is registered and which network announces it. The
## place is the register's, so an anycast address is in one place here
## and in many on the internet.
fn locate(kind: str, name: str, ip: str) -> map:
    var place = {"kind": kind, "name": name, "ip": ip, "lat": none, "lon": none, "country": "", "city": "", "asn": "", "holder": "", "prefix": ""}
    try:
        found = ripe("maxmind-geo-lite", ip)["located_resources"]
        if len(found) > 0 and len(found[0]["locations"]) > 0:
            spot = found[0]["locations"][0]
            place["lat"] = spot["latitude"]
            place["lon"] = spot["longitude"]
            place["country"] = spot["country"]
            place["city"] = spot["city"]
        net = ripe("network-info", ip)
        place["prefix"] = net["prefix"] ?? ""
        if len(net["asns"]) > 0:
            place["asn"] = net["asns"][0]
            place["holder"] = holder_of(net["asns"][0])
    else e:
        place["error"] = e.message
    return place

## What stands in front of a site, read from the headers of its answer.
fn front_of(headers: map) -> map:
    var names = []
    var evidence = []
    for rule in EDGES:
        value = headers[rule[0]] ?? ""
        if value != "" and rule[1] in value.lower():
            if not (rule[2] in names):
                names.add(rule[2])
            evidence.add("{rule[0]}: {value}")
    if len(names) == 0:
        return {"kind": "server", "name": headers["server"] ?? "", "evidence": []}
    return {"kind": "edge", "name": names[0], "evidence": evidence}

## One GET of https://domain/ and what answered it.
fn visit(domain: str) -> map:
    start = now
    try:
        r = http.get("https://{domain}/", timeout: 15s, retries: 0)
        return {"up": true, "status": r.status, "ms": int((now - start) / 1ms), "front": front_of(r.headers), "note": ""}
    else e:
        return {"up": e is HTTPError, "status": 0, "ms": int((now - start) / 1ms), "front": {"kind": "unknown", "name": "", "evidence": []}, "note": e.message}

## The networks between the collectors and the origin: for each one, in
## how many of the paths it is. A path is "peer ... origin"; a network
## that repeats itself in a path counts once.
fn transits(paths: list, origin: str) -> list:
    var seen = {}
    for path in paths:
        var once = []
        for asn in path.split(" "):
            if asn != origin and not (asn in once):
                once.add(asn)
        for asn in once:
            seen[asn] = (seen[asn] ?? 0) + 1
    rows = [{"asn": asn, "paths": seen[asn]} for asn in seen.keys()]
    return rows |> sort by paths desc

## How the world's routers see the route to an address: how many of the
## RIS collectors' peers have it, and the networks its paths go through.
fn route_of(ip: str) -> map:
    var route = {"ip": ip, "prefix": "", "origin": "", "seeing": 0, "total": 0, "state": "unknown", "paths": 0, "transits": []}
    try:
        status = ripe("routing-status", ip)
        family = "v4"
        if ":" in ip:
            family = "v6"
        seen = status["visibility"][family]
        route["prefix"] = status["resource"]
        route["seeing"] = seen["ris_peers_seeing"]
        route["total"] = seen["total_ris_peers"]
        route["state"] = route_state(seen["ris_peers_seeing"], seen["total_ris_peers"])
        if len(status["origins"]) > 0:
            route["origin"] = str(status["origins"][0]["origin"])
        var paths = []
        for collector in ripe("looking-glass", ip)["rrcs"]:
            for peer in collector["peers"]:
                paths.add(peer["as_path"])
        route["paths"] = len(paths)
        top = transits(paths, route["origin"]) |> take 8
        holders = parallel for row in top:
            return holder_of(row["asn"])
        route["transits"] = [{"asn": top[i]["asn"], "paths": top[i]["paths"], "holder": holders[i]} for i in range(len(top))]
        route["origin_holder"] = holder_of(route["origin"])
    else e:
        route["error"] = e.message
    return route

## A route every peer has is whole; one that some lost is partly cut;
## one nobody has is cut.
fn route_state(seeing: int, total: int) -> str:
    if total == 0:
        return "unknown"
    if seeing == 0:
        return "cut"
    if seeing * 100 < total * 95:
        return "partly cut"
    return "whole"

## The outages still open: for each country and signal, the last alert,
## kept when it is critical, with how far the signal fell.
fn open_outages(alerts: list) -> list:
    var last = {}
    for a in alerts |> sort by time:
        last["{a["entity"]["code"]} {a["datasource"]}"] = a
    var open = []
    for a in last.values():
        if a["level"] == "critical" and a["historyValue"] > 0 and a["value"] < a["historyValue"]:
            fall = int(100 - a["value"] * 100 / a["historyValue"])
            open.add({"code": a["entity"]["code"], "country": a["entity"]["name"], "signal": a["datasource"], "fall": fall, "since": a["time"]})
    return open |> sort by fall desc

## The country alerts of the last two days.
fn outages() -> list:
    try:
        until = int((now - time(1970, 1, 1, zone: "UTC")) / 1s)
        r = http.get("{IODA}?from={until - 172800}&until={until}&entityType=country&limit=1000", timeout: 60s)
        return open_outages(r.json()["data"])
    else e:
        return []

## A JSON text from the Submarine Cable Map, checked to be JSON.
fn cable_file(name: str) -> str:
    try:
        r = http.get("{CABLES}/{name}", timeout: 60s)
        r.json()
        return r.text
    else e:
        return "null"

fn trace(domain: str) -> map:
    print("DNS: the zones above {domain}")
    steps = delegation(domain)
    for s in steps:
        print("  {s["zone"]}  {len(s["servers"])} name servers")
    var answers = []
    try:
        answers = ask_dns(domain, "A")
    else e:
        print("  no address: {e.message}")
    aliases = records(answers, 5)
    addresses = records(answers, 1) |> take 4
    print("  addresses: {addresses}")
    var servers = []
    if len(steps) > 0:
        servers = steps[len(steps) - 1]["servers"] |> take 4
    print("Places: {len(servers)} name servers, {len(addresses)} addresses")
    server_places = parallel for name in servers:
        var ip = ""
        try:
            found = records(ask_dns(name, "A"), 1)
            if len(found) > 0:
                ip = found[0]
        else e:
            ip = ""
        return locate("name server", name, ip)
    site_places = parallel for ip in addresses:
        return locate("site", domain, ip)
    var observer = {}
    try:
        observer = locate("observer", "this observatory", ripe("whats-my-ip", "")["ip"])
    else e:
        observer = {"kind": "observer", "name": "this observatory", "lat": none, "lon": none}
    print("HTTPS: one request")
    site = visit(domain)
    print("  {site["front"]["kind"]}: {site["front"]["name"]}")
    var route = {"state": "unknown", "transits": []}
    if len(addresses) > 0:
        print("Route to {addresses[0]}")
        route = route_of(addresses[0])
        print("  {route["state"]}: {route["seeing"]} of {route["total"]} peers have it")
    print("Outages and cables")
    open = outages()
    print("  {len(open)} outage signals open")
    return {"domain": domain, "time": str(now.to_zone("UTC")), "observer": observer, "steps": steps, "aliases": aliases, "places": server_places + site_places, "site": site, "route": route, "outages": open}

## A JSON text that can stand inside a page's script: what came from the
## network must not be able to close the script.
fn inline(text: str) -> str:
    return text.replace("</", "<\\/")

## Writes the page: the template with the world, the cables and the trace in it.
fn page(data: map) -> str!:
    html = read("map.template.html")?
    world = read("data/world.json")?
    cables = cable_file("cable/cable-geo.json")
    landings = cable_file("landing-point/landing-point-geo.json")
    out = html.replace("\"__WORLD__\"", world).replace("\"__CABLES__\"", inline(cables)).replace("\"__LANDINGS__\"", inline(landings)).replace("\"__DATA__\"", inline(convert(data, to: json)))
    write("map.html", out)?
    return "map.html"

choice = input("Domain: ").trim().lower()
if choice == "":
    print("Nothing to trace: give a domain (example.com).")
else:
    try:
        written = page(trace(choice))
        print("Written {written}")
    else e:
        print("No map: {e.message}")

test "a text inside a script":
    assert inline("{{\"server\":\"</script>\"}") == "{{\"server\":\"<\\/script>\"}"

test "the zones above a name":
    assert zones_of("en.wikipedia.org") == [".", "org", "wikipedia.org", "en.wikipedia.org"]
    assert bare("ns0.wikimedia.org.") == "ns0.wikimedia.org"

test "the records of one type":
    answers = [{"type": 5, "data": "github.com."}, {"type": 1, "data": "140.82.114.3"}]
    assert records(answers, 1) == ["140.82.114.3"]
    assert records(answers, 5) == ["github.com"]

test "an edge in front of a site":
    edge = front_of({"server": "cloudflare", "cf-ray": "8f1-MAD"})
    assert edge["kind"] == "edge"
    assert edge["name"] == "Cloudflare"
    assert len(edge["evidence"]) == 2
    alone = front_of({"server": "nginx/1.25"})
    assert alone["kind"] == "server"
    assert alone["name"] == "nginx/1.25"

test "the networks of the paths":
    rows = transits(["8218 6461 3356 14907", "6894 3257 3356 3356 14907", "1299 14907"], "14907")
    assert rows[0] == {"asn": "3356", "paths": 2}
    assert len(rows) == 6

test "the state of a route":
    assert route_state(318, 318) == "whole"
    assert route_state(200, 318) == "partly cut"
    assert route_state(0, 318) == "cut"
    assert route_state(0, 0) == "unknown"

test "the outages still open":
    alerts = [
        {"entity": {"code": "VE", "name": "Venezuela"}, "datasource": "bgp", "level": "critical", "time": 10, "value": 50, "historyValue": 100},
        {"entity": {"code": "VE", "name": "Venezuela"}, "datasource": "bgp", "level": "normal", "time": 20, "value": 100, "historyValue": 100},
        {"entity": {"code": "TV", "name": "Tuvalu"}, "datasource": "gtr", "level": "critical", "time": 15, "value": 80, "historyValue": 320}
    ]
    assert open_outages(alerts) == [{"code": "TV", "country": "Tuvalu", "signal": "gtr", "fall": 75, "since": 15}]

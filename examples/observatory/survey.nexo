## What tells that an answer came through an edge (a CDN, a cache or a
## web firewall) and not straight from the server: a header, a text its
## value holds ("" for any) and who sends it.
EDGES = [
    ["cf-ray", "", "Cloudflare"],
    ["x-amz-cf-id", "", "Amazon CloudFront"],
    ["x-fastly-request-id", "", "Fastly"],
    ["x-served-by", "cache-", "Fastly"],
    ["x-akamai-transformed", "", "Akamai"],
    ["x-azure-ref", "", "Azure Front Door"],
    ["x-vercel-id", "", "Vercel"],
    ["x-nf-request-id", "", "Netlify"],
    ["x-sucuri-id", "", "Sucuri firewall"],
    ["x-iinfo", "", "Imperva firewall"],
    ["server", "cloudflare", "Cloudflare"],
    ["server", "cloudfront", "Amazon CloudFront"],
    ["server", "akamai", "Akamai"],
    ["server", "varnish", "a Varnish cache"],
    ["server", "ats", "an Apache Traffic Server cache"],
    ["via", "", "a proxy"],
    ["x-cache", "", "a cache"]
]

## Services where a name that is no longer in use can be taken by
## someone else: the end of the name a CNAME points to, and whose it is.
TAKEOVER = [
    [".s3.amazonaws.com", "Amazon S3"],
    [".cloudfront.net", "Amazon CloudFront"],
    [".elasticbeanstalk.com", "AWS Elastic Beanstalk"],
    [".github.io", "GitHub Pages"],
    [".herokuapp.com", "Heroku"],
    [".herokudns.com", "Heroku"],
    [".azurewebsites.net", "Azure App Service"],
    [".cloudapp.net", "Azure"],
    [".cloudapp.azure.com", "Azure"],
    [".trafficmanager.net", "Azure Traffic Manager"],
    [".blob.core.windows.net", "Azure Storage"],
    [".azureedge.net", "Azure CDN"],
    [".netlify.app", "Netlify"],
    [".vercel.app", "Vercel"],
    [".pages.dev", "Cloudflare Pages"],
    [".fastly.net", "Fastly"],
    [".myshopify.com", "Shopify"],
    [".zendesk.com", "Zendesk"],
    [".readthedocs.io", "Read the Docs"],
    [".surge.sh", "Surge"],
    [".ghost.io", "Ghost"]
]

## Ports that should not be open to the whole internet, and what
## listens on each.
RISKY = {
    "21": "FTP",
    "23": "Telnet",
    "445": "Windows file sharing",
    "1433": "SQL Server",
    "3306": "MySQL",
    "3389": "Remote Desktop",
    "5432": "PostgreSQL",
    "5900": "VNC",
    "6379": "Redis",
    "9200": "Elasticsearch",
    "11211": "memcached",
    "27017": "MongoDB"
}

## The names certificate authorities go by in a CAA record: how the
## organisation of an issuer starts, and its names.
AUTHORITIES = [
    ["Let's Encrypt", "letsencrypt.org"],
    ["DigiCert", "digicert.com"],
    ["Google Trust Services", "pki.goog"],
    ["Sectigo", "sectigo.com comodoca.com"],
    ["ZeroSSL", "sectigo.com zerossl.com"],
    ["Amazon", "amazon.com amazontrust.com awstrust.com amazonaws.com"],
    ["GlobalSign", "globalsign.com"],
    ["GoDaddy", "godaddy.com"],
    ["Microsoft", "microsoft.com digicert.com"],
    ["Buypass", "buypass.com"],
    ["SSL Corp", "ssl.com"]
]

## The zones a name is under, from the root down: "en.wikipedia.org" is
## under ".", "org", "wikipedia.org" and itself.
fn zones_of(domain: str) -> list:
    labels = domain.split(".")
    var zones = ["."]
    var zone = ""
    for i in range(len(labels)):
        label = labels[len(labels) - 1 - i]
        if zone == "":
            zone = label
        else:
            zone = "{label}.{zone}"
        zones.add(zone)
    return zones

## A name as DNS writes it in an answer, without its last dot.
fn bare(name: str) -> str:
    return LAST_DOT.replace(name, "")

## The whole answer of a resolver to one question (RFC 8484, as JSON).
fn answer(resolver: str, name: str, kind: str, more: str = "") -> map!:
    r = http.get("{resolver}?name={name}&type={kind}{more}", headers: {"accept": "application/dns-json"}, timeout: 15s)?
    return r.json()?

## The records the usual resolver has for one question.
fn ask_dns(name: str, kind: str) -> list!:
    return answer(RESOLVER, name, kind)?["Answer"] ?? []

## The records of one type (1 is A, 2 NS, 5 CNAME, 6 SOA, 12 PTR, 15 MX,
## 16 TXT, 28 AAAA, 257 CAA).
fn records(answers: list, kind: int) -> list:
    return [bare(a["data"]) for a in answers if a["type"] == kind]

## The name servers of each zone the domain is under; a name that is not
## a zone of its own has none and is left out.
fn delegation(domain: str) -> list:
    var steps = []
    for zone in zones_of(domain):
        try:
            servers = records(ask_dns(zone, "NS"), 2)
            if len(servers) > 0:
                steps.add({"zone": zone, "servers": servers})
        else e:
            steps.add({"zone": zone, "servers": [], "error": e.message})
    return steps

## The first text record that starts with a mark ("v=spf1"), without its quotes.
fn first_text(answers: list, mark: str) -> str:
    for text in records(answers, 16):
        clean = text.replace("\"", "")
        if clean.starts_with(mark):
            return clean
    return ""

## The number a text holds; 0 when it holds none.
fn number(text: str) -> int:
    try:
        return validate(text, as: int)
    else e:
        return 0

## The signature of an answer asked with its signatures (type 46 is
## RRSIG): its algorithm, and the seconds it is good from and until.
fn signature_of(answers: list) -> map:
    for a in answers:
        if a["type"] == 46:
            parts = a["data"].split(" ")
            if len(parts) > 5:
                return {"algorithm": number(parts[1]), "until": number(parts[4]), "since": number(parts[5])}
    return {"algorithm": 0, "until": 0, "since": 0}

## How many more questions a receiver must ask to read an SPF record;
## past ten it gives up, and the record counts for nothing.
fn spf_lookups(spf: str) -> int:
    var n = 0
    for term in spf.lower().split(" "):
        word = SPF_SIGN.replace(term, "").split(":")[0].split("/")[0].split("=")[0]
        if word in ["include", "a", "mx", "ptr", "exists", "redirect"]:
            n += 1
    return n

## The health of a domain's DNS: whether the answer is signed and checked
## (DNSSEC), how long it may be kept, what two resolvers answer, and the
## records mail and certificates depend on.
fn dns_health(domain: str) -> map:
    var out = {"dnssec": false, "ttl": none, "serial": "", "resolvers": [], "mx": [], "spf": "", "dmarc": "", "caa": [], "algorithm": 0, "signed_until": 0, "signed_since": 0, "mta_sts": "", "tls_rpt": "", "dane": false}
    try:
        full = answer(RESOLVER, domain, "A", more: "&do=1")
        out["dnssec"] = full["AD"] ?? false
        signed = signature_of(full["Answer"] ?? [])
        out["algorithm"] = signed["algorithm"]
        out["signed_until"] = signed["until"]
        out["signed_since"] = signed["since"]
        direct = [a for a in full["Answer"] ?? [] if a["type"] == 1]
        if len(direct) > 0:
            out["ttl"] = direct[0]["TTL"]
        out["resolvers"].add({"name": "Cloudflare", "addresses": records(full["Answer"] ?? [], 1)})
        other = answer(GOOGLE, domain, "A")
        out["resolvers"].add({"name": "Google", "addresses": records(other["Answer"] ?? [], 1)})
        soa = records(ask_dns(domain, "SOA"), 6)
        if len(soa) > 0 and len(soa[0].split(" ")) > 2:
            out["serial"] = soa[0].split(" ")[2]
        out["mx"] = records(ask_dns(domain, "MX"), 15)
        out["spf"] = first_text(ask_dns(domain, "TXT"), "v=spf1")
        out["dmarc"] = first_text(ask_dns("_dmarc.{domain}", "TXT"), "v=DMARC1")
        out["caa"] = records(ask_dns(domain, "CAA"), 257)
        if len(out["mx"]) > 0:
            out["mta_sts"] = first_text(ask_dns("_mta-sts.{domain}", "TXT"), "v=STSv1")
            out["tls_rpt"] = first_text(ask_dns("_smtp._tls.{domain}", "TXT"), "v=TLSRPTv1")
            first = out["mx"][0].split(" ")
            if len(first) > 1 and first[1] != "":
                out["dane"] = len(records(ask_dns("_25._tcp.{first[1]}", "TLSA"), 52)) > 0
    else e:
        out["error"] = e.message
    return out

## The name a certificate's issuer gives its organisation.
fn issuer_of(issuer: str) -> str:
    found = ORGANISATION.groups(issuer)
    if found == none:
        return issuer
    return found[0]

## What the public logs hold for a name: its certificates in force.
fn logged(domain: str) -> list:
    try:
        return http.get("{CRT}/?q={domain}&output=json&exclude=expired&deduplicate=Y", timeout: 40s).json()
    else e:
        return []

## The certificates of the logs, the newest first.
fn certificates(found: list) -> list:
    rows = [{"issuer": issuer_of(c["issuer_name"] ?? ""), "name": c["common_name"] ?? "", "starts": c["not_before"], "ends": c["not_after"]} for c in found]
    return rows |> sort by starts desc |> take 6

## The names under a domain that its certificates are for: the logs are
## a public list of a domain's subdomains.
fn logged_names(found: list, domain: str) -> list:
    var names = []
    for c in found:
        for raw in (c["name_value"] ?? "").split("\n"):
            name = raw.trim().lower().replace("*.", "")
            if name.ends_with(".{domain}") and not (name in names) and valid(name):
                names.add(name)
    return names |> take 12

## Whose service a name is at, where a name left behind can be taken.
fn service_of(target: str) -> str:
    for rule in TAKEOVER:
        if target.ends_with(rule[0]):
            return rule[1]
    return ""

## A name left hanging: an alias of a name that does not exist (status 3
## of a resolver's answer). Whoever makes that name answers for this one.
fn hanging_of(name: str, reply: map) -> map?:
    targets = records(reply["Answer"] ?? [], 5)
    if (reply["Status"] ?? 0) != 3 or len(targets) == 0:
        return none
    target = targets[len(targets) - 1]
    return {"name": name, "target": target, "service": service_of(target)}

## The subdomains of the logs, and those left hanging.
fn subdomains(found: list, domain: str) -> map:
    names = logged_names(found, domain)
    checked = parallel for name in names:
        var hit = none
        try:
            hit = hanging_of(name, answer(RESOLVER, name, "A"))
        else e:
            hit = none
        return hit
    return {"checked": len(names), "hanging": [h for h in checked if h != none]}

## What Shodan has seen open at an address, without asking the address
## anything: ports, software and its known vulnerabilities.
fn exposure(ip: str) -> map:
    var out = {"ip": ip, "known": false, "ports": [], "vulns": [], "tags": [], "software": [], "note": ""}
    try:
        seen = http.get("{SHODAN}/{ip}", timeout: 20s, retries: 0).json()
        out["known"] = true
        out["ports"] = seen["ports"] ?? []
        out["vulns"] = seen["vulns"] ?? []
        out["tags"] = seen["tags"] ?? []
        out["software"] = seen["cpes"] ?? []
    else e:
        if e is HTTPError:
            out["note"] = "Shodan has seen nothing open at {ip}."
        else:
            out["note"] = "Not read: {e.message}"
    return out

## One data call of RIPEstat (more: further parameters, "&prefix=...").
fn ripe(call: str, resource: str, more: str = "") -> map!:
    r = http.get("{RIPE}/{call}/data.json?resource={resource}{more}", timeout: 30s)?
    return r.json()?["data"]

## The holder of a network, by its number.
fn holder_of(asn: str) -> str:
    try:
        return ripe("as-overview", "AS{asn}")["holder"] ?? ""
    else e:
        return ""

## The holders of several networks, by number.
fn names_of(asns: list) -> map:
    holders = parallel for asn in asns, max: 16:
        return holder_of(asn)
    var names = {}
    for i in range(len(asns)):
        names[asns[i]] = holders[i]
    return names

## Where an address is registered and which network announces it. The
## place is the register's; an address answered from many places at once
## (anycast) has none.
fn locate(kind: str, name: str, ip: str) -> map:
    var place = {"kind": kind, "name": name, "ip": ip, "lat": none, "lon": none, "country": "", "city": "", "asn": "", "holder": "", "prefix": ""}
    try:
        found = ripe("maxmind-geo-lite", ip)["located_resources"]
        if len(found) > 0 and len(found[0]["locations"]) > 0 and found[0]["locations"][0]["country"] != "?":
            spot = found[0]["locations"][0]
            place["lat"] = spot["latitude"]
            place["lon"] = spot["longitude"]
            place["country"] = spot["country"]
            place["city"] = spot["city"]
        net = ripe("network-info", ip)
        place["prefix"] = net["prefix"] ?? ""
        if len(net["asns"]) > 0:
            place["asn"] = net["asns"][0]
            place["holder"] = holder_of(net["asns"][0])
    else e:
        place["error"] = e.message
    return place

## What stands in front of a site, read from the headers of its answer.
fn front_of(headers: map) -> map:
    var names = []
    var evidence = []
    for rule in EDGES:
        value = headers[rule[0]] ?? ""
        if value != "" and rule[1] in value.lower():
            if not (rule[2] in names):
                names.add(rule[2])
            evidence.add("{rule[0]}: {value}")
    if len(names) == 0:
        return {"kind": "server", "name": headers["server"] ?? "", "evidence": []}
    return {"kind": "edge", "name": names[0], "evidence": evidence}

## One GET of https://domain/ and what answered it.
fn visit(domain: str) -> map:
    start = now
    try:
        r = http.get("https://{domain}/", timeout: 15s, retries: 0)
        return {"up": true, "status": r.status, "ms": int((now - start) / 1ms), "front": front_of(r.headers), "hsts": r.headers["strict-transport-security"] ?? "", "note": ""}
    else e:
        return {"up": e is HTTPError, "status": 0, "ms": int((now - start) / 1ms), "front": {"kind": "unknown", "name": "", "evidence": []}, "hsts": "", "note": e.message}

## The networks between the collectors and the origin: for each one, in
## how many of the paths it is. A path is "peer ... origin"; a network
## that repeats itself in a path counts once.
fn transits(paths: list, origin: str) -> list:
    var seen = {}
    for path in paths:
        var once = []
        for asn in path.split(" "):
            if asn != origin and not (asn in once):
                once.add(asn)
        for asn in once:
            seen[asn] = (seen[asn] ?? 0) + 1
    rows = [{"asn": asn, "paths": seen[asn]} for asn in seen.keys()]
    return rows |> sort by paths desc

## The path most of a collector's peers have.
fn usual(paths: list) -> str:
    var count = {}
    for path in paths:
        count[path] = (count[path] ?? 0) + 1
    var best = ""
    for path in count.keys():
        if best == "" or count[path] > count[best]:
            best = path
    return best

## The links between networks that the paths use most: for each pair of
## neighbours, in how many paths one hands the traffic to the other.
fn links(paths: list, most: int) -> list:
    var seen = {}
    for path in paths:
        var once = []
        for asn in path.split(" "):
            if len(once) == 0 or once[len(once) - 1] != asn:
                once.add(asn)
        for i in range(len(once) - 1):
            pair = "{once[i]} {once[i + 1]}"
            seen[pair] = (seen[pair] ?? 0) + 1
    rows = [{"near": pair.split(" ")[0], "far": pair.split(" ")[1], "paths": seen[pair]} for pair in seen.keys()]
    return rows |> sort by paths desc |> take most

## Who has announced a prefix, from the history of routes: each origin
## with the first and the last day it was seen, the latest first.
fn origins_of(history: list, prefix: str) -> list:
    var rows = []
    for entry in history:
        for p in entry["prefixes"]:
            spans = p["timelines"]
            if p["prefix"] == prefix and len(spans) > 0:
                rows.add({"origin": str(entry["origin"]), "first": spans[0]["starttime"], "last": spans[len(spans) - 1]["endtime"]})
    return rows |> sort by last desc

## The longest prefix the authorisations (ROAs) that make a route valid
## allow; 0 when none does.
fn roa_max(roas: list) -> int:
    var most = 0
    for r in roas:
        if r["validity"] == "valid" and r["max_length"] > most:
            most = r["max_length"]
    return most

## How many peers have the route to an address, and whether its origin
## is authorised to announce it.
fn route_light(ip: str) -> map:
    var route = {"ip": ip, "prefix": "", "origin": "", "seeing": 0, "total": 0, "state": "unknown", "rpki": "unknown", "more_specifics": 0, "specifics": [], "roa_max": 0}
    try:
        status = ripe("routing-status", ip)
        var family = "v4"
        if ":" in ip:
            family = "v6"
        seen = status["visibility"][family]
        route["prefix"] = status["resource"]
        route["seeing"] = seen["ris_peers_seeing"]
        route["total"] = seen["total_ris_peers"]
        route["state"] = route_state(seen["ris_peers_seeing"], seen["total_ris_peers"])
        route["more_specifics"] = len(status["more_specifics"] ?? [])
        route["specifics"] = [{"prefix": m["prefix"], "origin": str(m["origin"])} for m in status["more_specifics"] ?? []]
        if len(status["origins"]) > 0:
            route["origin"] = str(status["origins"][0]["origin"])
            route["irr"] = status["origins"][0]["route_objects"] ?? []
            check = ripe("rpki-validation", route["origin"], more: "&prefix={route["prefix"]}")
            route["rpki"] = check["status"] ?? "unknown"
            route["roa_max"] = roa_max(check["validating_roas"] ?? [])
    else e:
        route["error"] = e.message
    return route

## What the route collectors see: each collector's usual path, the
## networks the paths go through and the links between them.
fn paths_of(ip: str, origin: str) -> map:
    var out = {"paths": 0, "collectors": [], "transits": [], "links": []}
    try:
        var paths = []
        for collector in ripe("looking-glass", ip)["rrcs"]:
            mine = [peer["as_path"] for peer in collector["peers"]]
            for path in mine:
                paths.add(path)
            spot = CITIES[collector["location"]] ?? [none, none]
            out["collectors"].add({"name": collector["rrc"], "city": collector["location"], "lat": spot[0], "lon": spot[1], "peers": len(mine), "path": usual(mine)})
        out["paths"] = len(paths)
        out["transits"] = transits(paths, origin) |> take 8
        out["links"] = links(paths, 28)
    else e:
        out["error"] = e.message
    return out

## A week of changes of a route, in samples of six hours.
fn changes_of(prefix: str) -> list:
    try:
        return [{"at": u["starttime"], "announced": u["announcements"], "withdrawn": u["withdrawals"]} for u in ripe("bgp-update-activity", prefix)["updates"]]
    else e:
        return []

## The five networks an origin buys most of its transit from.
fn upstreams_of(origin: str) -> list:
    try:
        near = ripe("asn-neighbours", "AS{origin}")["neighbours"] |> where it["type"] == "left" |> sort by power desc |> take 5
        return [str(n["asn"]) for n in near]
    else e:
        return []

## Every origin a prefix has had.
fn history_of(prefix: str) -> list:
    try:
        return origins_of(ripe("routing-history", prefix, more: "&min_peers=10")["by_origin"], prefix)
    else e:
        return []

## How the world's routers see the route to an address: how many of the
## RIS collectors' peers have it, the networks its paths go through, its
## changes, and who has announced it.
fn route_of(ip: str) -> map:
    var route = route_light(ip)
    seen = paths_of(ip, route["origin"])
    route["paths"] = seen["paths"]
    route["collectors"] = seen["collectors"]
    route["links"] = seen["links"]
    route["updates"] = []
    route["history"] = []
    var upstreams = []
    if route["prefix"] != "":
        route["updates"] = changes_of(route["prefix"])
        route["history"] = history_of(route["prefix"])
        upstreams = upstreams_of(route["origin"])
    var asns = []
    for asn in [route["origin"]] + upstreams + [t["asn"] for t in seen["transits"]] + [l["near"] for l in seen["links"]] + [l["far"] for l in seen["links"]] + [h["origin"] for h in route["history"]]:
        if asn != "" and not (asn in asns):
            asns.add(asn)
    names = names_of(asns)
    route["names"] = names
    route["origin_holder"] = names[route["origin"]] ?? ""
    route["transits"] = [{"asn": t["asn"], "paths": t["paths"], "holder": names[t["asn"]] ?? ""} for t in seen["transits"]]
    route["upstreams"] = [{"asn": asn, "holder": names[asn] ?? ""} for asn in upstreams]
    return route

## A route every peer has is whole; one that some lost is partly cut;
## one nobody has is cut.
fn route_state(seeing: int, total: int) -> str:
    if total == 0:
        return "unknown"
    if seeing == 0:
        return "cut"
    if seeing * 100 < total * 95:
        return "partly cut"
    return "whole"

## An address of a private network (RFC 1918, or the carriers' shared
## range), which is nowhere on the internet.
fn is_private(ip: str) -> bool:
    if ip.starts_with("10.") or ip.starts_with("192.168.") or ip.starts_with("127."):
        return true
    parts = ip.split(".")
    if len(parts) != 4:
        return false
    try:
        second = validate(parts[1], as: int)
        return (parts[0] == "172" and second >= 16 and second <= 31) or (parts[0] == "100" and second >= 64 and second <= 127)
    else e:
        return false

## The routers of one traceroute: for each hop the first router that
## answered and its time, how many packets were sent and how many got
## no answer.
fn hops_of(result: list) -> list:
    var hops = []
    for hop in result:
        var ip = ""
        var ms = none
        var sent = 0
        var lost = 0
        for reply in hop["result"] ?? []:
            sent += 1
            sender = reply["from"] ?? ""
            if sender == "":
                lost += 1
            if ip == "" and sender != "":
                ip = sender
                ms = reply["rtt"] ?? none
        hops.add({"n": hop["hop"], "ip": ip, "ms": ms, "sent": sent, "lost": lost})
    return hops

## The name to ask DNS for the host name of an IPv4 address.
fn reverse_name(ip: str) -> str:
    parts = ip.split(".")
    if len(parts) != 4:
        return ""
    return "{parts[3]}.{parts[2]}.{parts[1]}.{parts[0]}.in-addr.arpa"

## The host name of an address, or "".
fn host_of(ip: str) -> str:
    try:
        found = records(ask_dns(reverse_name(ip), "PTR"), 12)
        if len(found) > 0:
            return found[0].lower()
        return ""
    else e:
        return ""

## The city codes operators write in router names, from data/hubs.json.
fn hubs() -> map:
    var codes = {}
    try:
        for hub in json.parse(read("data/hubs.json")):
            for code in hub["codes"]:
                codes[code] = hub
    else e:
        codes = {}
    return codes

HUBS = hubs()

## The city a router's host name says it is in: operators write a city
## or airport code in it ("ffm-bb1-link.ip.twelve99.net" is Frankfurt).
## The last two labels are the operator's own name and are not read.
fn hub_of(host: str) -> map?:
    labels = host.lower().split(".")
    for i in range(len(labels) - 2):
        for word in LETTERS.split(labels[i]):
            if word in HUBS:
                return HUBS[word]
    return none

## Texts in one, with commas between them.
fn joined(items: list) -> str:
    var out = ""
    for item in items:
        if out != "":
            out = out + ","
        out = out + item
    return out

## One probe of RIPE Atlas in a country, or none.
fn probe_in(country: str) -> map?:
    try:
        r = http.get("{ATLAS}/probes/?country_code={country}&status=1&is_public=true&tags=system-ipv4-works&page_size=1&fields=id,country_code,geometry,asn_v4", timeout: 30s)
        found = r.json()["results"]
        if len(found) > 0 and found[0]["geometry"] != none:
            return found[0]
        return none
    else e:
        return none

## A probe by its number, or none.
fn probe_of(id: int) -> map?:
    try:
        found = http.get("{ATLAS}/probes/{id}/?fields=id,country_code,geometry,asn_v4", timeout: 30s).json()
        if found["geometry"] != none:
            return found
        return none
    else e:
        return none

## Where a router is and whose it is. Its host name is asked first: a
## city code in it is the router's real place; without one the place is
## the address register's, exact to the country at best.
fn router(ip: str) -> map:
    var place = {"ip": ip, "host": "", "lat": none, "lon": none, "city": "", "country": "", "asn": "", "by": ""}
    if ip == "" or is_private(ip):
        return place
    try:
        if not (":" in ip):
            place["host"] = host_of(ip)
        hub = hub_of(place["host"])
        if hub != none:
            place["lat"] = hub["lat"]
            place["lon"] = hub["lon"]
            place["city"] = hub["city"]
            place["by"] = "name"
        else:
            found = ripe("maxmind-geo-lite", ip)["located_resources"]
            if len(found) > 0 and len(found[0]["locations"]) > 0 and found[0]["locations"][0]["country"] != "?":
                spot = found[0]["locations"][0]
                place["lat"] = spot["latitude"]
                place["lon"] = spot["longitude"]
                place["country"] = spot["country"]
                place["by"] = "register"
        asns = ripe("network-info", ip)["asns"]
        if len(asns) > 0:
            place["asn"] = asns[0]
    else e:
        place["error"] = e.message
    return place

## A hop with the place and network of its router.
fn placed(hop: map, place: map, names: map) -> map:
    asn = place["asn"] ?? ""
    return {"n": hop["n"], "ip": hop["ip"], "ms": hop["ms"], "sent": hop["sent"], "lost": hop["lost"], "host": place["host"] ?? "", "lat": place["lat"] ?? none, "lon": place["lon"] ?? none, "city": place["city"] ?? "", "country": place["country"] ?? "", "by": place["by"] ?? "", "asn": asn, "holder": names[asn] ?? ""}

## Asks RIPE Atlas for a traceroute to a domain from eight probes around
## the world, once. It needs RIPE_ATLAS_KEY, as "Key <your key>".
fn start_trace(domain: str) -> int!:
    body = {"definitions": [{"target": domain, "af": 4, "type": "traceroute", "protocol": "ICMP", "description": "Nexo observatory: traceroute to {domain}", "resolve_on_probe": true}], "probes": [{"requested": 8, "type": "area", "value": "WW"}], "is_oneoff": true}
    r = http.post("{ATLAS}/measurements/", body, headers: {"Authorization": secret("RIPE_ATLAS_KEY")}, timeout: 30s)?
    return r.json()?["measurements"][0]

## Starts a traceroute to a domain nobody traces and says what happened.
fn begin(domain: str) -> str:
    try:
        id = start_trace(domain)
        db.Started.add(domain: domain, measurement: id, moment: now)
        return "Measurement {id} was started on RIPE Atlas for {domain} itself; its routers are read on the next run, in a few minutes."
    else e:
        return "To trace {domain} itself, set RIPE_ATLAS_KEY to \"Key <your key>\" (free at atlas.ripe.net)."

## The traceroute running now with most probes among those a search of
## RIPE Atlas finds, or none.
fn running(search: str) -> map?:
    try:
        found = http.get("{ATLAS}/measurements/?{search}&type=traceroute&status=2&af=4&page_size=50&fields=id,target,target_ip,participant_count", timeout: 30s).json()["results"]
        live = found |> where it["participant_count"] != none and it["participant_count"] > 0 |> sort by participant_count desc
        if len(live) == 0:
            return none
        return live[0]
    else e:
        return none

## The measurement to read the routers from. First the public one to the
## domain with most probes that is running now, then one this observatory
## started before. Few domains are traced, so the next choice is a
## traceroute to another address of the same network (origin): its
## routers are the way into that network, not to this very site, and the
## page says so. big: it has too many probes to read them all.
fn measurement_of(domain: str, origin: str) -> map:
    var out = {"id": none, "target": "", "name": domain, "kind": "domain", "big": false, "note": ""}
    try:
        chosen = running("target={domain}")
        if chosen != none:
            out["id"] = chosen["id"]
            out["target"] = chosen["target_ip"] ?? ""
            out["big"] = chosen["participant_count"] > 50
            return out
        wanted = domain
        mine = db.Started |> where domain == wanted |> sort by moment desc |> take 1
        if len(mine) > 0:
            out["id"] = mine[0].measurement
            return out
        out["note"] = "No probe of RIPE Atlas is tracing {domain} now. {begin(domain)}"
        if origin != "":
            near = running("target_asn={origin}")
            if near != none:
                out["id"] = near["id"]
                out["target"] = near["target_ip"] ?? ""
                out["name"] = near["target"] ?? ""
                out["kind"] = "network"
                out["big"] = near["participant_count"] > 50
    else e:
        out["note"] = "{out["note"]} RIPE Atlas did not answer: {e.message}".trim()
    return out

## Only the traceroutes of the last week: a probe that left years ago
## still has its last result.
fn recent(results: list) -> list:
    since = epoch() - 604800
    return [r for r in results if (r["timestamp"] ?? 0) > since]

## The traceroutes RIPE Atlas probes run to the domain (or, when nobody
## traces it, to its network: origin), read from up to eight probes, each
## hop with its place and network.
fn traceroutes(domain: str, origin: str) -> map:
    chosen = measurement_of(domain, origin)
    var out = {"measurement": chosen["id"], "target": chosen["target"], "name": chosen["name"], "kind": chosen["kind"], "probes": [], "note": chosen["note"]}
    if chosen["id"] == none:
        return out
    try:
        var probes = []
        var results = []
        if chosen["big"]:
            picked = parallel for country in PROBE_COUNTRIES:
                return probe_in(country)
            probes = [p for p in picked if p != none]
            ids = [str(p["id"]) for p in probes]
            results = recent(http.get("{ATLAS}/measurements/{chosen["id"]}/latest/?probe_ids={joined(ids)}", timeout: 60s)?.json()?)
        else:
            results = recent(http.get("{ATLAS}/measurements/{chosen["id"]}/latest/", timeout: 60s)?.json()?) |> take 8
            picked = parallel for r in results:
                return probe_of(r["prb_id"])
            probes = [p for p in picked if p != none]
        if len(results) == 0:
            out["note"] = "Measurement {chosen["id"]} has no results yet. Run again in a few minutes."
        var ips = []
        var traces = []
        for r in results:
            hops = hops_of(r["result"] ?? [])
            for h in hops:
                if h["ip"] != "" and not (h["ip"] in ips):
                    ips.add(h["ip"])
            if out["target"] == "":
                out["target"] = r["dst_addr"] ?? ""
            traces.add({"probe": r["prb_id"], "reached": r["destination_ip_responded"] ?? false, "hops": hops})
        routers = parallel for ip in ips, max: 16:
            return router(ip)
        var where = {}
        var asns = []
        for place in routers:
            where[place["ip"]] = place
            if place["asn"] != "" and not (place["asn"] in asns):
                asns.add(place["asn"])
        names = names_of(asns)
        for t in traces:
            var probe = none
            for p in probes:
                if p["id"] == t["probe"]:
                    probe = p
            if probe != none:
                hops = [placed(h, where[h["ip"]] ?? {}, names) for h in t["hops"]]
                out["probes"].add({"id": t["probe"], "country": probe["country_code"], "lon": probe["geometry"]["coordinates"][0], "lat": probe["geometry"]["coordinates"][1], "asn": str(probe["asn_v4"] ?? ""), "reached": t["reached"], "hops": hops})
    else e:
        out["note"] = "RIPE Atlas did not answer: {e.message}"
    return out

## The command that traces a route on a system: tracert on Windows,
## traceroute on Linux and macOS. Addresses are shown as numbers, each
## hop is asked once (three times by tracert, which has no fewer) and
## waited for two seconds, up to thirty hops.
fn trace_command(system: str, address: str) -> list:
    if system == "Windows":
        return ["tracert", "-d", "-h", "30", "-w", "2000", address]
    return ["traceroute", "-n", "-q", "1", "-w", "2", "-m", "30", address]

## The hops in what traceroute or tracert printed: a line that starts
## with the number of a hop has the router's address and its time, or
## stars when nothing answered.
fn local_hops(output: str) -> list:
    var hops = []
    for line in output.split("\n"):
        found = HOP_LINE.groups(line.replace("\r", ""))
        if found != none:
            ip = ADDRESS.find(found[1]) ?? ""
            var ms = none
            var n = 0
            try:
                n = validate(found[0], as: int)
                time = HOP_TIME.groups(found[1])
                if time != none and ip != "":
                    ms = validate(time[0], as: float)
            else e:
                ms = none
            var lost = 0
            if ip == "":
                lost = 1
            hops.add({"n": n, "ip": ip, "ms": ms, "sent": 1, "lost": lost})
    return hops

## The route from this machine to an address, traced by the system's own
## command, as a probe like those of RIPE Atlas, placed where this
## observatory is. probe is none, with a note, when the command is not
## installed or gives nothing.
fn local_probe(address: str, observer: map) -> map:
    var out = {"probe": none, "note": ""}
    try:
        system = platform.system()
        command = trace_command(system, address)
        if shutil.which(command[0]) == none:
            out["note"] = "This machine has no {command[0]} command, so its own route is not traced."
            return out
        done = subprocess.run(command, capture_output: true, text: true, timeout: 150)
        found = local_hops(done.stdout)
        if len(found) == 0:
            out["note"] = "The {command[0]} of this machine gave no hops."
            return out
        var ips = []
        for h in found:
            if h["ip"] != "" and not (h["ip"] in ips):
                ips.add(h["ip"])
        routers = parallel for ip in ips, max: 16:
            return router(ip)
        var where = {}
        var asns = []
        for place in routers:
            where[place["ip"]] = place
            if place["asn"] != "" and not (place["asn"] in asns):
                asns.add(place["asn"])
        names = names_of(asns)
        hops = [placed(h, where[h["ip"]] ?? {}, names) for h in found]
        out["probe"] = {"id": "this machine", "local": true, "tool": command[0], "country": observer["country"] ?? "", "lon": observer["lon"] ?? none, "lat": observer["lat"] ?? none, "asn": observer["asn"] ?? "", "reached": found[len(found) - 1]["ip"] == address, "hops": hops}
    else e:
        out["note"] = "The route of this machine was not traced: {e.message}"
    return out

## The same over IPv6: the addresses, the route, and whether the same
## probes reach the site.
fn six(domain: str, probes: list) -> map:
    var out = {"addresses": [], "route": none, "measurement": none, "probes": [], "note": ""}
    try:
        addresses = records(ask_dns(domain, "AAAA"), 28) |> take 2
        if len(addresses) == 0:
            out["note"] = "{domain} has no IPv6 address."
            return out
        out["addresses"] = parallel for ip in addresses:
            return locate("site", domain, ip)
        out["route"] = route_light(addresses[0])
        found = http.get("{ATLAS}/measurements/?target={domain}&type=traceroute&status=2&af=6&page_size=50&fields=id,target_ip,participant_count", timeout: 30s)?.json()?["results"]
        if len(found) == 0:
            out["note"] = "No probe of RIPE Atlas is tracing {domain} over IPv6 now."
            return out
        chosen = (found |> sort by participant_count desc)[0]
        out["measurement"] = chosen["id"]
        var filter = ""
        if chosen["participant_count"] > 50:
            filter = "?probe_ids={joined([str(p["id"]) for p in probes])}"
        results = http.get("{ATLAS}/measurements/{chosen["id"]}/latest/{filter}", timeout: 60s)?.json()? |> take 8
        var countries = {}
        for p in probes:
            countries[str(p["id"])] = p["country"]
        out["probes"] = [{"id": r["prb_id"], "country": countries[str(r["prb_id"])] ?? "", "reached": r["destination_ip_responded"] ?? false, "hops": len(r["result"] ?? [])} for r in results]
    else e:
        out["note"] = "Not read: {e.message}"
    return out

## Where a network meets others, from PeeringDB: the exchanges it is on
## and the buildings it is in, with their places.
fn peering(asn: str) -> map:
    var out = {"name": "", "policy": "", "traffic": "", "scope": "", "exchanges": [], "facilities": []}
    try:
        found = http.get("{PEERINGDB}/net?asn={asn}&depth=2", timeout: 30s)?.json()?["data"]
        if len(found) == 0:
            return out
        net = found[0]
        out["name"] = net["name"] ?? ""
        out["policy"] = net["policy_general"] ?? ""
        out["traffic"] = net["info_traffic"] ?? ""
        out["scope"] = net["info_scope"] ?? ""
        for lan in net["netixlan_set"] ?? []:
            if not (lan["name"] in out["exchanges"]):
                out["exchanges"].add(lan["name"])
        buildings = net["netfac_set"] ?? [] |> take 60
        if len(buildings) > 0:
            ids = [str(b["fac_id"]) for b in buildings]
            listed = http.get("{PEERINGDB}/fac?id__in={joined(ids)}&fields=id,name,city,country,latitude,longitude", timeout: 30s)?.json()?["data"]
            out["facilities"] = [{"name": f["name"], "city": f["city"], "country": f["country"], "lat": f["latitude"], "lon": f["longitude"]} for f in listed if f["latitude"] != none]
    else e:
        out["error"] = e.message
    return out

## The outages still open: for each country and signal, the last alert,
## kept when it is critical, with how far the signal fell.
fn open_outages(alerts: list) -> list:
    var last = {}
    for a in alerts |> sort by time:
        last["{a["entity"]["code"]} {a["datasource"]}"] = a
    var open = []
    for a in last.values():
        if a["level"] == "critical" and a["historyValue"] > 0 and a["value"] < a["historyValue"]:
            fall = int(100 - a["value"] * 100 / a["historyValue"])
            open.add({"code": a["entity"]["code"], "country": a["entity"]["name"], "signal": a["datasource"], "fall": fall, "since": a["time"]})
    return open |> sort by fall desc

## The seconds since 1970.
fn epoch() -> int:
    return int((now - time(1970, 1, 1, zone: "UTC")) / 1s)

## The alerts of the last two days still open, for every country
## (codes: "") or for some networks.
fn outages(kind: str, codes: str) -> list:
    try:
        until = epoch()
        var only = ""
        if codes != "":
            only = "&entityCode={codes}"
        r = http.get("{IODA}?from={until - 172800}&until={until}&entityType={kind}{only}&limit=1000", timeout: 60s)
        return open_outages(r.json()["data"])
    else e:
        return []

## Keeps this run and gives the ten before it, the latest first.
fn remember(data: map) -> list:
    try:
        wanted = data["domain"]
        earlier = db.Run |> where domain == wanted |> sort by moment desc |> take 10
        route = data["route"]
        site = data["site"]
        var address = ""
        for p in data["places"]:
            if p["kind"] == "site" and address == "":
                address = p["ip"]
        arrived = data["routers"]["probes"] |> where it["reached"] |> count
        db.Run.add(domain: wanted, moment: now, address: address, route: route["state"], seeing: route["seeing"] ?? 0, total: route["total"] ?? 0, arrived: arrived, probes: len(data["routers"]["probes"]), status: site["status"], ms: site["ms"], front: site["front"]["name"], rpki: route["rpki"] ?? "unknown", origin: route["origin"] ?? "")
        return [{"at": str(r.moment.to_zone("UTC")), "address": r.address, "route": r.route, "seeing": r.seeing, "total": r.total, "arrived": r.arrived, "probes": r.probes, "status": r.status, "ms": r.ms, "front": r.front, "rpki": r.rpki, "origin": r.origin} for r in earlier]
    else e:
        print("  history not kept: {e.message}")
        return []

## One thing to look at: how serious it is ("critical", "warning" or
## "notice"), the part of the survey it is about, what was seen and what
## to do about it.
fn alert(level: str, area: str, text: str, fix: str) -> map:
    return {"level": level, "area": area, "text": text, "fix": fix}

## The day of a moment written as "2026-11-20T00:00:00".
fn day(moment: str) -> str:
    return moment.split("T")[0]

## What the zone and its mail records leave open. A signature made to
## last under a week comes from a signer that signs each answer as it is
## asked, so its end is no alert. second: the one the
## survey runs at, to tell a signature about to end.
fn dns_alerts(health: map, places: list, second: int) -> list:
    var out = []
    if (health["error"] ?? "") != "":
        return out
    until = health["signed_until"] ?? 0
    life = until - (health["signed_since"] ?? 0)
    if not health["dnssec"]:
        out.add(alert("warning", "DNS", "The zone is not signed: a forged answer cannot be told from a true one.", "Sign the zone and publish its DS record at the registrar."))
    elif until > 0 and until < second + 259200 and life > 604800:
        out.add(alert("critical", "DNS", "The signatures of the zone end in less than three days: after that, resolvers that check them stop answering for the name.", "Sign the zone again now, and find why the signer stopped."))
    if (health["algorithm"] ?? 0) in [1, 3, 5, 6, 7]:
        out.add(alert("warning", "DNS", "The zone is signed with algorithm {health["algorithm"]}, which rests on SHA-1; resolvers are dropping it.", "Sign with algorithm 13 (ECDSA P-256) or 15 (Ed25519)."))
    var networks = []
    var servers = 0
    var named = 0
    for p in places:
        if p["kind"] == "name server":
            named += 1
            if (p["ip"] ?? "") == "":
                out.add(alert("warning", "DNS", "The name server {p["name"] ?? ""} has no address: part of the delegation leads nowhere.", "Take it out of the delegation, or give it an address. If its name can be registered by someone else, they can take the zone."))
        if p["kind"] == "name server" and str(p["asn"]) != "":
            servers += 1
            if not (str(p["asn"]) in networks):
                networks.add(str(p["asn"]))
    if named == 1:
        out.add(alert("warning", "DNS", "The zone has one name server: when it stops, the name stops resolving.", "Add a second name server, in another network."))
    if servers > 1 and len(networks) == 1:
        out.add(alert("warning", "DNS", "The {servers} name servers placed are all in one network, AS{networks[0]}: when it fails, the name stops resolving.", "Add a name server in another network."))
    spf = health["spf"].lower()
    if spf == "":
        out.add(alert("warning", "Mail", "No SPF record: any server can send mail as this domain.", "Publish the TXT record v=spf1 -all if the domain sends no mail, or one that lists its senders."))
    elif "+all" in spf:
        out.add(alert("critical", "Mail", "SPF ends in +all: every server in the world is allowed to send mail as this domain.", "End the record with -all."))
    elif "?all" in spf:
        out.add(alert("warning", "Mail", "SPF ends in ?all: it says nothing about servers it does not list.", "End the record with -all, or ~all while the senders are counted."))
    lookups = spf_lookups(spf)
    if lookups > 10:
        out.add(alert("warning", "Mail", "The SPF record needs {lookups} more questions; receivers stop at ten and then treat it as broken.", "Replace include and a/mx terms with ip4 and ip6 ranges until ten or fewer are left."))
    if len(health["mx"] ?? []) > 0 and (health["mta_sts"] ?? "x") == "" and not (health["dane"] ?? true):
        out.add(alert("notice", "Mail", "Neither MTA-STS nor DANE: a network in between can make senders deliver the mail of this domain without encryption.", "Publish an MTA-STS policy (and the _smtp._tls record to get the reports), or TLSA records if the zone is signed."))
    dmarc = health["dmarc"].lower().replace(" ", "")
    if dmarc == "":
        out.add(alert("warning", "Mail", "No DMARC record: receivers are not told what to do with forged mail.", "Publish a TXT record at _dmarc with p=quarantine or p=reject."))
    elif "p=none" in dmarc:
        out.add(alert("notice", "Mail", "DMARC is p=none: forged mail is reported, and still delivered.", "Move to p=quarantine once the reports show only your own senders."))
    if len(health["caa"]) == 0:
        out.add(alert("notice", "DNS", "No CAA record: any authority may issue a certificate for this name.", "Publish a CAA record that names the authorities you use."))
    return out

## The names an authority goes by in CAA records; "" for one not known.
fn authority_names(issuer: str) -> str:
    for rule in AUTHORITIES:
        if issuer.starts_with(rule[0]):
            return rule[1]
    return ""

## An issuer the CAA records name, or one this table does not know.
fn allowed_by(caa: list, issuer: str) -> bool:
    names = authority_names(issuer)
    rules = [c.lower() for c in caa if " issue" in c.lower()]
    if names == "" or len(rules) == 0:
        return true
    for name in names.split(" "):
        for rule in rules:
            if name in rule:
                return true
    return false

## The names left hanging among those of the certificate logs.
fn subdomain_alerts(subs: map) -> list:
    var out = []
    for h in subs["hanging"] ?? []:
        if h["service"] != "":
            out.add(alert("critical", "Subdomains", "{h["name"]} is an alias of {h["target"]}, which no longer exists at {h["service"]}: whoever creates it there serves pages under your name.", "Delete the record, or create the resource again."))
        else:
            out.add(alert("warning", "Subdomains", "{h["name"]} is an alias of {h["target"]}, which does not exist.", "Delete the record; if the target's domain can be registered, someone else can answer for this name."))
    return out

## What Shodan has seen open at the site's address. edge: what stands
## in front of the site, "" when the address is the server's own.
fn exposure_alerts(exposed: map, edge: str) -> list:
    var out = []
    var whose = ""
    if edge != "":
        whose = " The address is the edge's ({edge}), not the server behind it."
    vulns = exposed["vulns"] ?? []
    if len(vulns) > 0:
        out.add(alert("critical", "Exposure", "{len(vulns)} known vulnerabilities in the software Shodan saw at {exposed["ip"]}: {joined(vulns |> take 3).replace(",", ", ")}.{whose}", "Update that software, then read each CVE: Shodan goes by version numbers and can be wrong."))
    for port in exposed["ports"] ?? []:
        what = RISKY[str(port)] ?? ""
        if what != "":
            out.add(alert("warning", "Exposure", "Port {port} ({what}) is open to the whole internet at {exposed["ip"]}.{whose}", "Close it at the firewall, or leave it open to your own addresses only."))
    return out

## What the site and its certificates show. soon: the day before which a
## certificate that ends is an alert. caa: who may issue for the name.
fn site_alerts(site: map, certs: list, soon: str, caa: list) -> list:
    var out = []
    if not site["up"]:
        out.add(alert("critical", "Site", "The site did not answer: {site["note"]}", "Check the server, and what stands in front of it."))
    elif site["status"] >= 500:
        out.add(alert("warning", "Site", "The site answered {site["status"]}, an error of the server.", "Read the server's log."))
    elif site["status"] < 400 and (site["hsts"] ?? "x") == "":
        out.add(alert("warning", "Site", "No HSTS header: a browser's first visit can be sent to plain http and read on the way.", "Send Strict-Transport-Security: max-age=31536000."))
    var latest = ""
    var strangers = []
    for c in certs:
        if c["ends"] > latest:
            latest = c["ends"]
        issuer = c["issuer"] ?? ""
        if not allowed_by(caa, issuer) and not (issuer in strangers):
            strangers.add(issuer)
    for issuer in strangers:
        out.add(alert("warning", "Certificates", "A certificate in force was issued by {issuer}, which the CAA records do not name.", "If you did not ask for it, have it revoked; if you did, add the authority to the CAA records."))
    if latest != "" and latest < soon:
        out.add(alert("warning", "Certificates", "The newest certificate in the public logs ends on {day(latest)}.", "Renew it, and check that the renewal still runs by itself."))
    return out

## What the route shows: a cut, an origin nobody authorised, a second
## origin since the day `lately`, one network every path depends on.
fn route_alerts(route: map, lately: str) -> list:
    var out = []
    origin = route["origin"] ?? ""
    prefix = route["prefix"] ?? ""
    if route["state"] == "cut":
        out.add(alert("critical", "Route", "No peer of the route collectors has the route to {prefix}.", "Check that AS{origin} announces the prefix and that its upstreams accept it."))
    elif route["state"] == "partly cut":
        out.add(alert("warning", "Route", "Only {route["seeing"]} of {route["total"]} peers have the route to {prefix}.", "Look for the upstream that stopped passing it on."))
    rpki = route["rpki"] ?? "unknown"
    if "invalid" in rpki:
        out.add(alert("critical", "Route", "RPKI says {rpki}: AS{origin} is not authorised to announce {prefix}. Networks that check drop this route; it can be a hijack.", "Publish a ROA for this prefix and origin, or stop the announcement if it is not yours."))
    elif rpki == "unknown" and origin != "":
        out.add(alert("warning", "Route", "No ROA covers {prefix}: nobody can check that AS{origin} may announce it.", "Publish a ROA at your regional registry."))
    var length = 0
    if "/" in prefix:
        length = number(prefix.split("/")[1])
    if rpki == "valid" and (route["roa_max"] ?? 0) > length:
        out.add(alert("warning", "Route", "The ROA allows prefixes as long as /{route["roa_max"]} and /{length} is announced: a forged, more specific route would pass as valid.", "Set the maximum length of the ROA to /{length}."))
    for m in (route["specifics"] ?? []) |> take 3:
        if m["origin"] != origin:
            out.add(alert("warning", "Route", "{m["prefix"]}, a part of {prefix}, is announced by AS{m["origin"]}: routers send it the traffic for those addresses. A customer's block, or a hijack.", "Check that AS{m["origin"]} holds that block from you."))
    if origin != "" and len(route["irr"] ?? ["?"]) == 0:
        out.add(alert("notice", "Route", "No route object in the routing registries for {prefix} from AS{origin}: networks that filter by them may refuse the route.", "Create the route object at your registry."))
    for h in route["history"] ?? []:
        if h["origin"] != origin and h["last"] >= lately:
            out.add(alert("critical", "Route", "AS{h["origin"]} also announced {prefix}, until {day(h["last"])}: a hand-over, or a hijack.", "Ask the holder of the prefix whether AS{h["origin"]} is theirs."))
    upstreams = route["upstreams"] ?? []
    paths = route["paths"] ?? 0
    if len(upstreams) == 1:
        out.add(alert("warning", "Route", "AS{origin} has one upstream, AS{upstreams[0]["asn"]}: when it fails, the route is cut.", "Buy transit from a second network."))
    elif paths >= 10:
        for t in route["transits"] ?? []:
            if t["paths"] == paths:
                out.add(alert("warning", "Route", "Every one of the {paths} paths seen goes through AS{t["asn"]}: a single point of failure.", "Announce the prefix through a second network."))
    return out

## What the routers, the networks on the way and IPv6 show.
fn reach_alerts(routers: map, path_outages: list, v6: map) -> list:
    var out = []
    sent = len(routers["probes"])
    arrived = routers["probes"] |> where it["reached"] |> count
    if sent > 0 and arrived == 0:
        out.add(alert("critical", "Routers", "None of the {sent} probes reached the site.", "Read the traces: the last router that answers is where to look."))
    elif arrived < sent:
        out.add(alert("warning", "Routers", "{sent - arrived} of {sent} probes did not reach the site.", "Compare the traces that arrive with those that do not."))
    for o in path_outages:
        out.add(alert("warning", "Outages", "An outage signal is open on {o["country"]}, a network of the route: {o["signal"]} fell {o["fall"]}%.", "Watch the route; move traffic to another upstream if it worsens."))
    if len(v6["addresses"]) == 0 and "no IPv6" in v6["note"]:
        out.add(alert("notice", "IPv6", "The name has no IPv6 address.", "Publish an AAAA record."))
    return out

## What is not as it was in the run before.
fn change_alerts(data: map, before: map?) -> list:
    var out = []
    if before == none:
        return out
    route = data["route"]
    origin = route["origin"] ?? ""
    if before["origin"] != "" and origin != "" and before["origin"] != origin:
        out.add(alert("critical", "Changes", "The origin of the route changed from AS{before["origin"]} to AS{origin} since the last run.", "If you did not move the prefix, treat it as a hijack: call your upstreams."))
    if before["rpki"] == "valid" and (route["rpki"] ?? "unknown") != "valid":
        out.add(alert("warning", "Changes", "RPKI was valid in the last run and is {route["rpki"] ?? "unknown"} now.", "Check that the ROA has not expired or been removed."))
    var address = ""
    for p in data["places"]:
        if p["kind"] == "site" and address == "":
            address = p["ip"]
    if before["address"] != "" and address != "" and before["address"] != address:
        out.add(alert("notice", "Changes", "The address changed from {before["address"]} to {address} since the last run.", "Usual behind a CDN; otherwise check who changed the record."))
    front = data["site"]["front"]["name"]
    if before["front"] != front and data["site"]["up"]:
        out.add(alert("notice", "Changes", "What answers changed from \"{before["front"]}\" to \"{front}\" since the last run.", "Check that the change of edge or server was planned."))
    return out

## The alerts of a survey, the most serious first. soon and lately are
## days as text: a certificate that ends before `soon`, and a second
## origin seen since `lately`, are alerts.
fn alerts_of(data: map, soon: str, lately: str, second: int) -> list:
    var before = none
    if len(data["history"]) > 0:
        before = data["history"][0]
    var edge = ""
    if data["site"]["front"]["kind"] == "edge":
        edge = data["site"]["front"]["name"]
    found = dns_alerts(data["health"], data["places"], second) + subdomain_alerts(data["subdomains"] ?? {}) + site_alerts(data["site"], data["certificates"], soon, data["health"]["caa"] ?? []) + exposure_alerts(data["exposure"] ?? {}, edge) + route_alerts(data["route"], lately) + reach_alerts(data["routers"], data["path_outages"], data["v6"]) + change_alerts(data, before)
    var out = []
    for level in ["critical", "warning", "notice"]:
        for a in found:
            if a["level"] == level:
                out.add(a)
    return out

## The parts of a survey and the areas of the alerts each one answers for.
BLOCKS = [
    ["DNS", "DNS Subdomains"],
    ["Mail", "Mail"],
    ["Routes", "Route Routers Outages Changes"],
    ["Site", "Site Certificates Exposure IPv6"]
]

## A mark from 0 to 100 for each part of a survey: 100 less 40 for each
## critical alert, 15 for each warning and 5 for each notice.
fn scores(alerts: list) -> list:
    var out = []
    for block in BLOCKS:
        var mark = 100
        var found = 0
        for a in alerts:
            if a["area"] in block[1].split(" "):
                found += 1
                if a["level"] == "critical":
                    mark -= 40
                elif a["level"] == "warning":
                    mark -= 15
                else:
                    mark -= 5
        if mark < 0:
            mark = 0
        out.add({"block": block[0], "score": mark, "alerts": found})
    return out

## The latest text kept under a name, when it is younger than an age;
## otherwise "".
fn kept(name: str, age) -> str:
    try:
        wanted = name
        found = db.Kept |> where name == wanted |> sort by moment desc |> take 1
        if len(found) > 0 and now - found[0].moment < age:
            return found[0].body
        return ""
    else e:
        return ""

## Keeps a text under a name, in place of the one before.
fn keep(name: str, body: str):
    try:
        wanted = name
        for old in db.Kept |> where name == wanted:
            db.Kept.remove(old.id)
        db.Kept.add(name: name, moment: now, body: body)
    else e:
        print("  not kept: {e.message}")

## A JSON text from the Submarine Cable Map, checked to be JSON and kept
## for a day; "null" when the map does not answer.
fn cable_file(name: str) -> str:
    saved = kept(name, 24h)
    if saved != "":
        return saved
    try:
        r = http.get("{CABLES}/{name}", timeout: 60s)
        r.json()
        keep(name, r.text)
        return r.text
    else e:
        return "null"

## A kept cable file as data, or none when it could not be read.
fn cable_data(name: str) -> map?:
    try:
        return json.parse(cable_file(name))
    else e:
        return none

## The routes of the submarine cables (GeoJSON), or none.
pub fn cables() -> map?:
    return cable_data("cable/cable-geo.json")

## The places where the cables land (GeoJSON), or none.
pub fn landings() -> map?:
    return cable_data("landing-point/landing-point-geo.json")

## Whether a text is a domain name: labels of letters, digits and hyphens
## and a last one of letters, so neither an address nor a name of the
## local network is asked for.
pub fn valid(domain: str) -> bool:
    return len(domain) <= 253 and DOMAIN.matches(domain)

## The survey of a domain, asked now. It takes a minute or two.
pub fn trace(domain: str) -> map:
    print("DNS: the zones above {domain}")
    steps = delegation(domain)
    for s in steps:
        print("  {s["zone"]}  {len(s["servers"])} name servers")
    var answers = []
    try:
        answers = ask_dns(domain, "A")
    else e:
        print("  no address: {e.message}")
    aliases = records(answers, 5)
    addresses = records(answers, 1) |> take 4
    print("  addresses: {addresses}")
    health = dns_health(domain)
    print("  DNSSEC checked: {health["dnssec"]}")
    var servers = []
    if len(steps) > 0:
        servers = steps[len(steps) - 1]["servers"] |> take 4
    print("Places: {len(servers)} name servers, {len(addresses)} addresses")
    server_places = parallel for name in servers:
        var ip = ""
        try:
            found = records(ask_dns(name, "A"), 1)
            if len(found) > 0:
                ip = found[0]
        else e:
            ip = ""
        return locate("name server", name, ip)
    site_places = parallel for ip in addresses:
        return locate("site", domain, ip)
    var observer = {}
    try:
        observer = locate("observer", "this observatory", ripe("whats-my-ip", "")["ip"])
    else e:
        observer = {"kind": "observer", "name": "this observatory", "lat": none, "lon": none}
    print("HTTPS: one request, and the certificates in the logs")
    site = visit(domain)
    print("  {site["front"]["kind"]}: {site["front"]["name"]}")
    found = logged(domain)
    certs = certificates(found)
    subs = subdomains(found, domain)
    print("  {len(certs)} certificates in force, {subs["checked"]} names of the logs checked, {len(subs["hanging"])} left hanging")
    var exposed = {"ip": "", "known": false, "ports": [], "vulns": [], "tags": [], "software": [], "note": ""}
    if len(addresses) > 0:
        exposed = exposure(addresses[0])
        print("  {len(exposed["ports"])} ports seen open by Shodan, {len(exposed["vulns"])} known vulnerabilities")
    var route = {"state": "unknown", "transits": [], "origin": ""}
    var meets = {"exchanges": [], "facilities": []}
    if len(addresses) > 0:
        print("Route to {addresses[0]}")
        route = route_of(addresses[0])
        print("  {route["state"]}: {route["seeing"]} of {route["total"]} peers have it")
        meets = peering(route["origin"])
        print("  on {len(meets["exchanges"])} exchanges, in {len(meets["facilities"])} buildings")
    print("Routers: the traceroutes of RIPE Atlas")
    routers = traceroutes(domain, route["origin"])
    reached = routers["probes"] |> where it["reached"] |> count
    print("  {reached} of {len(routers["probes"])} probes reached it {routers["note"]}")
    print("IPv6")
    v6 = six(domain, routers["probes"])
    print("  {len(v6["addresses"])} addresses {v6["note"]}")
    print("Outages and cables")
    open = outages("country", "")
    on_path = [route["origin"]] + [t["asn"] for t in route["transits"]]
    var path_open = []
    if route["origin"] != "":
        path_open = outages("asn", joined(on_path))
    print("  {len(open)} outage signals open in countries, {len(path_open)} on the networks of the route")
    routers["local_note"] = ""
    if len(addresses) > 0:
        print("This machine's own route to {addresses[0]}")
        mine = local_probe(addresses[0], observer)
        routers["local_note"] = mine["note"]
        if mine["probe"] != none:
            routers["probes"] = [mine["probe"]] + routers["probes"]
            print("  {len(mine["probe"]["hops"])} hops, arrived: {mine["probe"]["reached"]}")
        else:
            print("  {mine["note"]}")
    var data = {"domain": domain, "time": str(now.to_zone("UTC")), "observer": observer, "steps": steps, "aliases": aliases, "health": health, "places": server_places + site_places, "site": site, "certificates": certs, "subdomains": subs, "exposure": exposed, "route": route, "peering": meets, "routers": routers, "v6": v6, "outages": open, "path_outages": path_open}
    data["history"] = remember(data)
    print("  {len(data["history"])} earlier runs of {domain} kept")
    data["alerts"] = alerts_of(data, str(date(now + 336h)), str(date(now - 720h)), epoch())
    data["scores"] = scores(data["alerts"])
    print("Alerts: {len(data["alerts"])}")
    return data

## The survey of a domain as JSON text: the one kept when it is younger
## than a quarter of an hour, unless a fresh one is asked for.
pub fn report(domain: str, fresh: bool) -> str:
    name = "survey {domain}"
    if not fresh:
        saved = kept(name, 15m)
        if saved != "":
            return saved
    body = convert(trace(domain), to: json)
    keep(name, body)
    return body

## The domains surveyed here, the latest first, each with its last run.
pub fn surveyed() -> list:
    try:
        var seen = []
        var rows = []
        for r in db.Run |> sort by moment desc:
            if not (r.domain in seen):
                seen.add(r.domain)
                rows.add({"domain": r.domain, "at": str(r.moment.to_zone("UTC")), "route": r.route, "arrived": r.arrived, "probes": r.probes, "status": r.status})
        return rows |> take 30
    else e:
        return []

test "a domain name":
    assert valid("wikipedia.org")
    assert valid("en.wikipedia.org")
    assert not valid("localhost")
    assert not valid("127.0.0.1")
    assert not valid("example.com/path")
    assert not valid("-bad.example")
    assert not valid("")

test "the zones above a name":
    assert zones_of("en.wikipedia.org") == [".", "org", "wikipedia.org", "en.wikipedia.org"]
    assert bare("ns0.wikimedia.org.") == "ns0.wikimedia.org"

test "the records of one type":
    answers = [{"type": 5, "data": "github.com."}, {"type": 1, "data": "140.82.114.3"}]
    assert records(answers, 1) == ["140.82.114.3"]
    assert records(answers, 5) == ["github.com"]

test "an edge in front of a site":
    edge = front_of({"server": "cloudflare", "cf-ray": "8f1-MAD"})
    assert edge["kind"] == "edge"
    assert edge["name"] == "Cloudflare"
    assert len(edge["evidence"]) == 2
    alone = front_of({"server": "nginx/1.25"})
    assert alone["kind"] == "server"
    assert alone["name"] == "nginx/1.25"

test "the networks of the paths":
    rows = transits(["8218 6461 3356 14907", "6894 3257 3356 3356 14907", "1299 14907"], "14907")
    assert rows[0] == {"asn": "3356", "paths": 2}
    assert len(rows) == 6

test "the usual path of a collector":
    assert usual(["1 2 3", "4 3", "1 2 3"]) == "1 2 3"
    assert usual([]) == ""

test "private addresses":
    assert is_private("10.0.0.1")
    assert is_private("172.20.1.1")
    assert is_private("100.64.0.1")
    assert not is_private("172.32.0.1")
    assert not is_private("104.16.132.229")

test "the routers of a traceroute":
    result = [
        {"hop": 1, "result": [{"from": "202.214.97.2", "rtt": 1.2}, {"from": "202.214.97.2", "rtt": 1.3}]},
        {"hop": 2, "result": [{"x": "*"}, {"x": "*"}]},
        {"hop": 3, "result": [{"x": "*"}, {"from": "104.16.132.229", "rtt": 1.6}]}
    ]
    hops = hops_of(result)
    assert hops[0] == {"n": 1, "ip": "202.214.97.2", "ms": 1.2, "sent": 2, "lost": 0}
    assert hops[1] == {"n": 2, "ip": "", "ms": none, "sent": 2, "lost": 2}
    assert hops[2] == {"n": 3, "ip": "104.16.132.229", "ms": 1.6, "sent": 2, "lost": 1}

test "the city in a router's name":
    assert reverse_name("58.138.114.237") == "237.114.138.58.in-addr.arpa"
    assert hub_of("ffm-bb1-link.ip.twelve99.net")["city"] == "Frankfurt"
    assert hub_of("tky009bb51.iij.net")["city"] == "Tokyo"
    assert hub_of("be3187.ccr42.fra03.atlas.cogentco.com")["city"] == "Frankfurt"
    assert hub_of("ae-1.r20.londen12.uk.bb.gin.ntt.net")["city"] == "London"
    assert hub_of("static.example.net") == none
    assert hub_of("") == none

test "the links between networks":
    rows = links(["8218 6461 3356 14907", "6894 3257 3356 3356 14907", "1299 14907"], 2)
    assert rows[0] == {"near": "3356", "far": "14907", "paths": 2}
    assert len(rows) == 2

test "the origins a prefix has had":
    history = [
        {"origin": "3352", "prefixes": [{"prefix": "208.0.0.0/7", "timelines": [{"starttime": "2007-08-15", "endtime": "2007-08-26"}]}]},
        {"origin": "14907", "prefixes": [{"prefix": "208.80.154.0/23", "timelines": [{"starttime": "2019-09-07", "endtime": "2020-01-01"}, {"starttime": "2020-01-02", "endtime": "2026-11-13"}]}]}
    ]
    assert origins_of(history, "208.80.154.0/23") == [{"origin": "14907", "first": "2019-09-07", "last": "2026-11-13"}]

test "what DNS and a certificate say":
    assert bare("10 mx-in1001.wikimedia.org.") == "10 mx-in1001.wikimedia.org"
    answers = [{"type": 16, "data": "\"google-site-verification=x\""}, {"type": 16, "data": "\"v=spf1 include:_spf.example.org ~all\""}]
    assert first_text(answers, "v=spf1") == "v=spf1 include:_spf.example.org ~all"
    assert first_text(answers, "v=DMARC1") == ""
    assert issuer_of("C=US, O=Let's Encrypt, CN=YE2") == "Let's Encrypt"
    assert issuer_of("C=US, O=\"DigiCert, Inc.\", CN=G2") == "DigiCert"

test "only the traceroutes of the last week":
    fresh = [{"prb_id": 1, "timestamp": epoch() - 60}, {"prb_id": 2, "timestamp": 1500000000}, {"prb_id": 3}]
    assert [r["prb_id"] for r in recent(fresh)] == [1]

test "the hops traceroute and tracert print":
    assert trace_command("Linux", "192.0.2.7")[0] == "traceroute"
    assert trace_command("Darwin", "192.0.2.7")[0] == "traceroute"
    assert trace_command("Windows", "192.0.2.7") == ["tracert", "-d", "-h", "30", "-w", "2000", "192.0.2.7"]
    unix = local_hops("traceroute to 192.0.2.7 (192.0.2.7), 30 hops max, 60 byte packets\n 1  192.168.1.1  0.182 ms\n 2  *\n 3  192.0.2.7  12.5 ms\n")
    assert unix[0] == {"n": 1, "ip": "192.168.1.1", "ms": 0.182, "sent": 1, "lost": 0}
    assert unix[1] == {"n": 2, "ip": "", "ms": none, "sent": 1, "lost": 1}
    assert unix[2]["ip"] == "192.0.2.7"
    windows = local_hops("Tracing route to 192.0.2.7 over a maximum of 30 hops\r\n\r\n  1    <1 ms    <1 ms    <1 ms  192.168.1.1\r\n  2     *        *        *     Request timed out.\r\n  3    12 ms    11 ms    13 ms  192.0.2.7\r\n\r\nTrace complete.\r\n")
    assert windows[0] == {"n": 1, "ip": "192.168.1.1", "ms": 1.0, "sent": 1, "lost": 0}
    assert windows[1]["lost"] == 1
    assert windows[2] == {"n": 3, "ip": "192.0.2.7", "ms": 12.0, "sent": 1, "lost": 0}

test "the state of a route":
    assert route_state(318, 318) == "whole"
    assert route_state(200, 318) == "partly cut"
    assert route_state(0, 318) == "cut"
    assert route_state(0, 0) == "unknown"

test "the outages still open":
    alerts = [
        {"entity": {"code": "VE", "name": "Venezuela"}, "datasource": "bgp", "level": "critical", "time": 10, "value": 50, "historyValue": 100},
        {"entity": {"code": "VE", "name": "Venezuela"}, "datasource": "bgp", "level": "normal", "time": 20, "value": 100, "historyValue": 100},
        {"entity": {"code": "TV", "name": "Tuvalu"}, "datasource": "gtr", "level": "critical", "time": 15, "value": 80, "historyValue": 320}
    ]
    assert open_outages(alerts) == [{"code": "TV", "country": "Tuvalu", "signal": "gtr", "fall": 75, "since": 15}]

test "the alerts of a survey":
    health = {"dnssec": false, "spf": "v=spf1 +all", "dmarc": "v=DMARC1; p=none", "caa": ["0 issue \"letsencrypt.org\""]}
    places = [{"kind": "name server", "asn": "64500", "ip": "192.0.2.1"}, {"kind": "name server", "asn": "64500", "ip": "192.0.2.2"}, {"kind": "site", "asn": "64501", "ip": "198.51.100.7"}]
    route = {"state": "whole", "seeing": 318, "total": 318, "prefix": "198.51.100.0/24", "origin": "64501", "rpki": "invalid_asn", "paths": 12, "history": [{"origin": "64501", "first": "2019-01-01T00:00:00", "last": "2026-11-13T00:00:00"}, {"origin": "64666", "first": "2026-11-10T00:00:00", "last": "2026-11-12T00:00:00"}, {"origin": "64777", "first": "2007-01-01T00:00:00", "last": "2007-02-01T00:00:00"}], "upstreams": [{"asn": "64510", "holder": "ONE"}, {"asn": "64511", "holder": "TWO"}], "transits": [{"asn": "64510", "paths": 12}, {"asn": "64511", "paths": 5}]}
    site = {"up": true, "status": 200, "note": "", "front": {"name": "nginx"}}
    certs = [{"ends": "2026-11-20T00:00:00"}, {"ends": "2026-09-01T00:00:00"}]
    routers = {"probes": [{"reached": true}, {"reached": false}]}
    earlier = [{"origin": "64999", "rpki": "valid", "address": "198.51.100.7", "front": "nginx"}]
    data = {"health": health, "places": places, "route": route, "site": site, "certificates": certs, "routers": routers, "path_outages": [], "v6": {"addresses": [], "note": "example.org has no IPv6 address."}, "history": earlier}
    found = alerts_of(data, "2026-11-28", "2026-10-15", 1794000000)
    for a in found:
        print("{a["level"]}  {a["area"]}: {a["text"]}")
    assert found[0]["fix"] == "End the record with -all."
    data["history"] = []
    data["places"] = [{"kind": "name server", "asn": "64500", "ip": "192.0.2.1"}, {"kind": "name server", "asn": "64502", "ip": "203.0.113.2"}]
    data["health"] = {"dnssec": true, "spf": "v=spf1 -all", "dmarc": "v=DMARC1; p=reject", "caa": ["0 issue \";\""]}
    data["route"] = {"state": "whole", "prefix": "198.51.100.0/24", "origin": "64501", "rpki": "valid", "paths": 12, "history": [], "upstreams": [], "transits": []}
    data["certificates"] = [{"ends": "2027-02-01T00:00:00"}]
    data["routers"] = {"probes": [{"reached": true}]}
    data["v6"] = {"addresses": [{"ip": "2001:db8::7"}], "note": ""}
    assert alerts_of(data, "2026-11-28", "2026-10-15", 1794000000) == []
    assert scores([]) == [{"block": "DNS", "score": 100, "alerts": 0}, {"block": "Mail", "score": 100, "alerts": 0}, {"block": "Routes", "score": 100, "alerts": 0}, {"block": "Site", "score": 100, "alerts": 0}]

test "what is weak in DNS, the route and the site":
    health = {"dnssec": true, "algorithm": 5, "signed_until": 1794100000, "signed_since": 1791500000, "spf": "v=spf1 include:a.example include:b.example include:c.example include:d.example include:e.example include:f.example include:g.example a mx a:h.example mx:i.example exists:j.example -all", "dmarc": "v=DMARC1; p=reject", "caa": ["0 issue \"letsencrypt.org\""], "mx": ["10 mail.example.org"], "mta_sts": "", "dane": false}
    places = [{"kind": "name server", "name": "ns1.example.org", "asn": "64500", "ip": "192.0.2.1"}, {"kind": "name server", "name": "ns2.gone.example", "asn": "", "ip": ""}]
    route = {"state": "whole", "prefix": "198.51.100.0/23", "origin": "64501", "rpki": "valid", "roa_max": 24, "specifics": [{"prefix": "198.51.100.0/24", "origin": "64666"}, {"prefix": "198.51.101.0/24", "origin": "64501"}], "irr": [], "paths": 12, "history": [], "upstreams": [], "transits": []}
    site = {"up": true, "status": 200, "hsts": "", "note": "", "front": {"kind": "edge", "name": "Cloudflare"}}
    certs = [{"issuer": "Let's Encrypt", "ends": "2027-02-01T00:00:00"}, {"issuer": "DigiCert", "ends": "2027-01-01T00:00:00"}, {"issuer": "A Small Authority", "ends": "2027-01-01T00:00:00"}]
    subs = {"checked": 2, "hanging": [{"name": "old.example.org", "target": "old-shop.s3.amazonaws.com", "service": "Amazon S3"}, {"name": "lab.example.org", "target": "lab.gone.example", "service": ""}]}
    exposed = {"ip": "198.51.100.7", "ports": [443, 3389], "vulns": ["CVE-2024-0001", "CVE-2024-0002"]}
    data = {"health": health, "places": places, "route": route, "site": site, "certificates": certs, "subdomains": subs, "exposure": exposed, "routers": {"probes": []}, "path_outages": [], "v6": {"addresses": [{"ip": "2001:db8::7"}], "note": ""}, "history": []}
    found = alerts_of(data, "2026-11-28", "2026-10-15", 1794000000)
    for a in found:
        print("{a["level"]}  {a["area"]}: {a["text"]}")
    for s in scores(found):
        print("{s["block"]}: {s["score"]} ({s["alerts"]} alerts)")

test "what the logs, a signature and Shodan say":
    logs = [{"name_value": "*.example.org\nexample.org\nshop.example.org"}, {"name_value": "shop.example.org\nmail.other.example\nbad_name.example.org"}]
    assert logged_names(logs, "example.org") == ["shop.example.org"]
    gone = {"Status": 3, "Answer": [{"type": 5, "data": "old-shop.s3.amazonaws.com."}]}
    assert hanging_of("old.example.org", gone) == {"name": "old.example.org", "target": "old-shop.s3.amazonaws.com", "service": "Amazon S3"}
    assert hanging_of("www.example.org", {"Status": 0, "Answer": [{"type": 5, "data": "example.org."}, {"type": 1, "data": "192.0.2.1"}]}) == none
    assert hanging_of("none.example.org", {"Status": 3}) == none
    signed = [{"type": 1, "data": "104.16.132.229"}, {"type": 46, "data": "A 13 2 300 1794766414 1794586414 34505 cloudflare.com. wdFX=="}]
    assert signature_of(signed) == {"algorithm": 13, "until": 1794766414, "since": 1794586414}
    assert signature_of([]) == {"algorithm": 0, "until": 0, "since": 0}
    brief = {"dnssec": true, "signed_until": 1794100000, "signed_since": 1793920000, "spf": "v=spf1 -all", "dmarc": "v=DMARC1; p=reject", "caa": ["0 issue \";\""]}
    assert dns_alerts(brief, [], 1794000000) == []
    assert spf_lookups("v=spf1 ip4:192.0.2.0/24 include:_spf.example.org ~all") == 1
    assert spf_lookups("v=spf1 a mx/24 +include:x.example redirect=y.example") == 4
    assert roa_max([{"validity": "valid", "max_length": 23}, {"validity": "invalid_length", "max_length": 24}]) == 23
    assert allowed_by(["0 issue \"letsencrypt.org\""], "Let's Encrypt")
    assert not allowed_by(["0 issue \"letsencrypt.org\""], "DigiCert")
    assert allowed_by([], "DigiCert")
    assert allowed_by(["0 issue \"letsencrypt.org\""], "A Small Authority")

{
  "logs": [
    "logs/benign.log",
    "logs/attack.log",
    "logs/unicode.log",
    "logs/oversized.log",
    "logs/nginx.log",
    "logs/binary.log",
    "logs/../sentinel.json",
    "/etc/passwd"
  ],
  "never_block": ["192.0.2.10"],
  "firewall": "http://127.0.0.1:8787",
  "max_failed_logins": 5,
  "max_not_found": 10,
  "max_object_ids": 8,
  "suppress": [
    {
      "rule": "SEN-109",
      "source": "192.0.2.51",
      "reason": "password reset links carry a one-time token (SEC-142)"
    }
  ],
  "max_login_sources": 4,
  "incremental": false,
  "alert_webhook": "",
  "alertmanager": "",
  "loki": "",
  "loki_window": "15m",
  "loki_lines": 1000,
  "loki_queries": [
    {
      "name": "nginx",
      "query": "{job=\"nginx\"}"
    }
  ]
}

## Times of logs for the Sentinel programs: ISO 8601, the combined format
## of nginx and Apache, and syslog, as seconds since 1970 in UTC.

iso_time = regex("^([0-9]{{4})-([0-9]{{2})-([0-9]{{2})[T ]([0-9]{{2}):([0-9]{{2}):([0-9]{{2})(\\.[0-9]+)?(Z|([+-])([0-9]{{2}):?([0-9]{{2}))?")
clf_time = regex("^([0-9]{{2})/([A-Z][a-z]{{2})/([0-9]{{4}):([0-9]{{2}):([0-9]{{2}):([0-9]{{2}) ([+-])([0-9]{{2})([0-9]{{2})")
syslog_time = regex("^([A-Z][a-z]{{2}) +([0-9]{{1,2}) ([0-9]{{2}):([0-9]{{2}):([0-9]{{2})")
day_text = regex("^([0-9]{{4})-([0-9]{{2})")
MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

fn number(text: str) -> int!:
    n: int = validate(text, as: int)?
    return n

## The days from 1970-01-01 to a day of the calendar.
fn days_from_civil(year: int, month: int, day: int) -> int:
    var y = year
    if month <= 2:
        y = year - 1
    era = int(y / 400)
    yoe = y - era * 400
    mp = (month + 9) % 12
    doy = int((153 * mp + 2) / 5) + day - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468

fn month_of(name: str) -> int:
    var n = 0
    for known in MONTHS:
        n += 1
        if known == name:
            return n
    return 0

fn seconds_at(year: int, month: int, day: int, hour: int, minute: int, second: int) -> int:
    return days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second

## When a line happened, in seconds since 1970 in UTC, from the time it
## shows (ISO 8601, the combined format, or syslog); -1 when it cannot be
## read. A syslog time has no year and no zone: it is UTC, of the year of
## `today`, or of the year before for a month still to come.
pub fn epoch_of(text: str, today_text: str) -> int!:
    iso = iso_time.groups(text)
    if iso != none:
        var moment = seconds_at(number(iso[0])?, number(iso[1])?, number(iso[2])?, number(iso[3])?, number(iso[4])?, number(iso[5])?)
        if iso[8] != none:
            offset = number(iso[9])? * 3600 + number(iso[10])? * 60
            if iso[8] == "+":
                moment = moment - offset
            else:
                moment = moment + offset
        return moment
    clf = clf_time.groups(text)
    if clf != none and month_of(clf[1]) > 0:
        moment = seconds_at(number(clf[2])?, month_of(clf[1]), number(clf[0])?, number(clf[3])?, number(clf[4])?, number(clf[5])?)
        offset = number(clf[7])? * 3600 + number(clf[8])? * 60
        if clf[6] == "+":
            return moment - offset
        return moment + offset
    sys = syslog_time.groups(text)
    now_parts = day_text.groups(today_text)
    if sys != none and month_of(sys[0]) > 0 and now_parts != none:
        var year = number(now_parts[0])?
        if month_of(sys[0]) > number(now_parts[1])?:
            year = year - 1
        return seconds_at(year, month_of(sys[0]), number(sys[1])?, number(sys[2])?, number(sys[3])?, number(sys[4])?)
    return -1

## Now, in seconds since 1970 in UTC.
pub fn now_seconds() -> int!:
    return epoch_of(str(now), str(today))?

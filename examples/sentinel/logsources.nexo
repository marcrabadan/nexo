## Where sentinel.nexo reads logs besides files: Loki, Elasticsearch or
## OpenSearch, Splunk, Datadog, Graylog, Azure Monitor (Log Analytics)
## and Google Cloud Logging. Each gives the lines of a query in the
## last window, the oldest first, and at most `limit` of them. They only
## read. A source with `auth` sends the Authorization header kept in a
## variable of the environment; Datadog always sends its two keys.
use monitoring

window_parts = regex("^([0-9]{{1,4})([smhd])$")
guid = regex("^[0-9a-fA-F]{{8}-[0-9a-fA-F]{{4}-[0-9a-fA-F]{{4}-[0-9a-fA-F]{{4}-[0-9a-fA-F]{{12}$")
project_id = regex("^[a-z][a-z0-9-]{{4,29}$")
origin = regex("^https?://[^/]+")
index_name = regex("^[A-Za-z0-9_.*,-]{{1,200}$")

fn authorization(entry: map, variable: str) -> map:
    if entry["auth"] ?? false:
        return {"Authorization": secret(variable)}
    return {}

fn reversed(lines: list) -> list:
    var out = []
    for line in lines:
        out = [line] + out
    return out

## Loki: `query` is LogQL, such as {{job="nginx"}.
fn loki(entry: map, window: str, limit: int) -> list!:
    return reversed(monitoring.log_lines(entry["url"], entry["query"], window, limit, authorization(entry, "SENTINEL_LOKI_AUTH"))?)

## Elasticsearch and OpenSearch: `query` is a query string, `index` the
## index or pattern, `field` the field with the line (message).
fn elastic(entry: map, window: str, limit: int) -> list!:
    index = entry["index"] ?? ""
    if index_name.find(index) == none:
        fail("the index of an elastic source is letters, digits and . _ - * ,")
    field = entry["field"] ?? "message"
    body = {"size": limit, "sort": [{"@timestamp": {"order": "desc"}}], "query": {"bool": {"filter": [{"query_string": {"query": entry["query"]}}, {"range": {"@timestamp": {"gte": "now-{window}"}}}]}}}
    answer = http.post("{entry["url"]}/{index}/_search", body, headers: authorization(entry, "SENTINEL_ELASTIC_AUTH"), timeout: 15s)?
    var lines = []
    for hit in answer.json()["hits"]["hits"]:
        line = hit["_source"][field]
        if line != none:
            lines.add(str(line))
    return reversed(lines)

## Splunk: `query` is what follows `search`, such as index=web.
fn splunk(entry: map, window: str, limit: int) -> list!:
    search = monitoring.encoded("search {entry["query"]} | head {limit}")
    var headers = authorization(entry, "SENTINEL_SPLUNK_AUTH")
    headers["Content-Type"] = "application/x-www-form-urlencoded"
    answer = http.post("{entry["url"]}/services/search/jobs/export", "search={search}&earliest_time=-{window}&latest_time=now&output_mode=json", headers: headers, timeout: 30s)?
    var lines = []
    for row in answer.text.split("\n"):
        if row.trim() != "":
            result = json.parse(row)?["result"]
            if result != none:
                lines.add(str(result["_raw"]))
    return reversed(lines)

## Datadog: `query` is a log search, such as service:web.
fn datadog(entry: map, window: str, limit: int) -> list!:
    headers = {"DD-API-KEY": secret("SENTINEL_DATADOG_API_KEY"), "DD-APPLICATION-KEY": secret("SENTINEL_DATADOG_APP_KEY")}
    body = {"filter": {"query": entry["query"], "from": "now-{window}", "to": "now"}, "sort": "-timestamp", "page": {"limit": limit}}
    answer = http.post("{entry["url"]}/api/v2/logs/events/search", body, headers: headers, timeout: 15s)?
    var lines = []
    for event in answer.json()["data"]:
        line = event["attributes"]["message"]
        if line != none:
            lines.add(str(line))
    return reversed(lines)

## Graylog: `query` is a search, such as source:web. The window goes in
## seconds.
fn graylog(entry: map, window: str, limit: int) -> list!:
    seconds = seconds_of(window)?
    var headers = authorization(entry, "SENTINEL_GRAYLOG_AUTH")
    headers["Accept"] = "application/json"
    answer = http.get("{entry["url"]}/api/search/universal/relative?query={monitoring.encoded(entry["query"])}&range={seconds}&limit={limit}&sort=timestamp%3Adesc&fields=message", headers: headers, timeout: 15s)?
    var lines = []
    for found in answer.json()["messages"]:
        line = found["message"]["message"]
        if line != none:
            lines.add(str(line))
    return reversed(lines)

## A window as seconds: 15m is 900.
fn seconds_of(window: str) -> int!:
    parts = window_parts.groups(window)
    if parts == none:
        fail("the window of a source is a number and s, m, h or d")
    amount: int = validate(parts[0], as: int)?
    if parts[1] == "m":
        return amount * 60
    if parts[1] == "h":
        return amount * 3600
    if parts[1] == "d":
        return amount * 86400
    return amount

## Azure Monitor: `query` is KQL over a Log Analytics workspace, such as
## ContainerLogV2 | order by TimeGenerated asc; `workspace` is its id and
## `field` the column with the line (LogMessage). The token of Azure AD
## is the Authorization header in SENTINEL_AZURE_AUTH.
fn azure(entry: map, window: str, limit: int) -> list!:
    workspace = entry["workspace"] ?? ""
    if guid.find(workspace) == none:
        fail("the workspace of an azure source is its id, such as 0f8fad5b-d9cb-469f-a165-70867728950e")
    parts = window_parts.groups(window)
    if parts == none:
        fail("the window of a source is a number and s, m, h or d")
    var span = "PT{parts[0]}{parts[1].upper()}"
    if parts[1] == "d":
        span = "P{parts[0]}D"
    field = entry["field"] ?? "LogMessage"
    answer = http.post("{entry["url"]}/v1/workspaces/{workspace}/query", {"query": "{entry["query"]} | take {limit}", "timespan": span}, headers: {"Authorization": secret("SENTINEL_AZURE_AUTH")}, timeout: 30s)?
    var lines = []
    for table in answer.json()["tables"]:
        var column = -1
        var position = 0
        for described in table["columns"]:
            if described["name"] == field:
                column = position
            position += 1
        if column < 0:
            fail("the answer of Azure has no column {field}; name it with field")
        for row in table["rows"]:
            if row[column] != none:
                lines.add(str(row[column]))
    return lines

## Google Cloud Logging: `query` is a filter, such as
## resource.type="k8s_container"; `project` is the project's id. A text
## entry is its text; a request of a load balancer is read as an access
## line. The token is the Authorization header in SENTINEL_GCP_AUTH.
fn gcp(entry: map, window: str, limit: int) -> list!:
    project = entry["project"] ?? ""
    if project_id.find(project) == none:
        fail("the project of a gcp source is its id, such as my-project-123")
    since = str(now - seconds_of(window)? * 1s)
    body = {"resourceNames": ["projects/{project}"], "filter": "({entry["query"]}) AND timestamp>=\"{since}\"", "orderBy": "timestamp desc", "pageSize": limit}
    answer = http.post("{entry["url"]}/v2/entries:list", body, headers: {"Authorization": secret("SENTINEL_GCP_AUTH")}, timeout: 30s)?
    var lines = []
    for found in answer.json()["entries"] ?? []:
        request = found["httpRequest"]
        payload = found["jsonPayload"]
        if found["textPayload"] != none:
            lines.add(str(found["textPayload"]))
        elif request != none and request["remoteIp"] != none:
            lines.add("{found["timestamp"] ?? "-"} {request["remoteIp"]} gcp {request["requestMethod"] ?? "GET"} {origin.replace(str(request["requestUrl"] ?? "/"), "")} {request["status"] ?? 0}")
        elif payload != none and payload["message"] != none:
            lines.add(str(payload["message"]))
    return reversed(lines)

## The kinds of source there are.
pub fn kinds() -> list:
    return ["loki", "elastic", "splunk", "datadog", "graylog", "azure", "gcp"]

## The lines of a source of sentinel.json, the oldest first.
pub fn lines_of(entry: map, window: str, limit: int) -> list!:
    kind = entry["kind"] ?? ""
    if (entry["url"] ?? "") == "" or (entry["query"] ?? "") == "":
        fail("a source needs a url and a query")
    if kind == "loki":
        return loki(entry, window, limit)?
    if kind == "elastic":
        return elastic(entry, window, limit)?
    if kind == "splunk":
        return splunk(entry, window, limit)?
    if kind == "datadog":
        return datadog(entry, window, limit)?
    if kind == "graylog":
        return graylog(entry, window, limit)?
    if kind == "azure":
        return azure(entry, window, limit)?
    if kind == "gcp":
        return gcp(entry, window, limit)?
    fail("the kind of a source is loki, elastic, splunk, datadog, graylog, azure or gcp")

type Point:
    x: int
    y: int = 0
    fn moved(self, dx):
        return Point(self.x + dx, self.y)
    fn norm1(self) -> int:
        return self.x + self.y
p = Point(1, 2)
print(p)
print(Point(x: 5))
print(p.moved(3))
print(p.moved(dx: 1).norm1())
print(p == Point(1, 2))
print(p == Point(2, 1))
q = p
q.x = 9
print(p.x)
type Shape:
    Circle(r: float)
    Rect(w: float, h: float)
    Empty
    fn area(self) -> float:
        match self:
            Circle(r): return 3.0 * r * r
            Rect(w, h): return w * h
            Empty: return 0.0
for s in [Circle(1.0), Rect(2.0, 3.0), Empty]:
    print("{s}: {s.area()}")
print(Empty == Empty)
print(Circle(1.0) is Shape)
print(Rect(1.0, 2.0).w)
trait Named:
    fn name(self) -> str
type Dog is Named:
    n: str
    fn name(self) -> str:
        return "dog {self.n}"
print(Dog("rex").name())
print(Dog("a") is Named)
print(p is Named)
type Status = "on" | "off"
fn flip(s: Status) -> Status:
    if s == "on":
        return "off"
    return "on"
print(flip("on"))
type Box:
    items: list[int]
    label: str?
b = Box([1, 2])
print(b)
b.items.add(3)
print(b.items)

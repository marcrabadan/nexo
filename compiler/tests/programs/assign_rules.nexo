n = 1
fn bump():
    n += 10
    return n
print(bump())
print(n)
var g = 0
fn setg():
    g = 5
setg()
print(g)
fn nested():
    var local = 1
    fn inner():
        local += 1
        return local
    inner()
    inner()
    return local
print(nested())

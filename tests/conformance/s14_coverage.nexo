# nexo test --coverage: the branches the tests ran (D152)
type Shape:
    Circle(r: int)
    Square(side: int)

type Counter:
    n: int

    fn bump(self) -> int:
        return self.n + 1

fn area(s: Shape) -> int:
    match s:
        Circle(r):
            return 3 * r * r
        Square(side):
            return side * side

fn sign(n: int) -> str:
    if n > 0:
        return "+"
    elif n < 0:
        return "-"
    else:
        return "0"

fn clamp(n: int) -> int:
    expect n > -1000
    var out = n
    if n > 100:
        out = 100
    return out

fn total(xs: list) -> int:
    var t = 0
    for x in xs:
        t += x
    while t > 1000:
        t -= 1000
    return t

fn parse(text: str) -> int:
    try:
        return validate(text, as: int)?
    else e:
        return -1

var saved = []

action keep(x: int):
    do: saved = saved + [x]
    undo: saved = [s for s in saved if s != x]

fn safe(n: int) -> int!:
    var out = 0
    protect(sign, fails: 3, wait: 1m):
        out = n
    return out

workflow steps(n: int):
    step print("step", n)
        undo print("undo", n)

test "some of each":
    assert area(Circle(1)) == 3
    assert sign(5) == "+"
    assert sign(0) == "0"
    assert clamp(500) == 100
    assert total([]) == 0
    assert parse("7") == 7
    keep(1)
    assert safe(2) == 2

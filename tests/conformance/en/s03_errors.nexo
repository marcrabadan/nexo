type Config:
    port: int

type Logger:
    fn error(self, e):
        print("ERROR: {e.message}")

log = Logger()

pub fn load_config(path: str) -> Config!:
    text = read(path)?                # if it fails, return the error
    return json.parse(text, as: Config)?

try:
    cfg = load_config("app.json")
    print("Port: {cfg.port}")
else e:
    print("Could not load the configuration: {e.message}")

try:
    other = load_config("missing.json")
    print("Port: {other.port}")
else e:
    print("Could not load the configuration: {e.message}")

fn divide(a, b):
    if b == 0:
        fail("Cannot divide by zero")
    return a / b

try:
    print(divide(10, 4))
    print(divide(1, 0))
else e:
    print(e.message)

try:
    data = read("config.txt")
else e is NotFound:                   # handle a specific type
    data = ""
else e:
    log.error(e)
print("data: [{data}]")

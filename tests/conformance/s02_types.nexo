type User:
    name: str
    age: int
    email: str?

    fn is_adult(self) -> bool:
        return self.age >= 18

type Status = "active" | "closed"   # union of values

type Event:                          # enum with data
    Click(x: int, y: int)
    Key(code: str)
    Quit

trait Shape:
    fn area(self) -> float

type Circle is Shape:
    radius: float
    fn area(self) -> float:
        return PI * self.radius ** 2

u = User(name: "Ana", age: 30)
print(u.is_adult())
print(u)
s: Status = "active"
print(s)
c = Circle(radius: 2.0)
print(c.area())
print(c is Shape)
print(Click(x: 150, y: 20))
print(Key(code: "q"))
print(Quit)

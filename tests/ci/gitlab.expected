# Generated by nexo ci export gitlab from app.nexo; do not edit.
# secrets (CI/CD variables): DEPLOY_KEY
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "main"
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
stages:
  - build
  - dev
  - prod
  - after
default:
  image: python:3.12
  before_script:
    - pip install nexo
  artifacts:
    when: always
    paths:
      - .nexo/ci/
variables:
  GIT_DEPTH: 0
build:
  stage: build
  script:
    - nexo ci run main app.nexo --step build --yes
dev:
  stage: dev
  script:
    - nexo ci run main app.nexo --step dev --yes
prod:
  stage: prod
  # approve: ana@company.com, luis@company.com
  when: manual
  allow_failure: false
  script:
    - nexo ci run main app.nexo --step prod --yes
after-success:
  stage: after
  when: on_success
  script:
    - nexo ci run main app.nexo --after success
after-failure:
  stage: after
  when: on_failure
  script:
    - nexo ci run main app.nexo --after failure

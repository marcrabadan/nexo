# Generated by nexo ci export github from app.nexo; do not edit.
name: main
on:
  push:
    branches:
      - 'main'
  pull_request:
env:
  DEPLOY_KEY: ${{ secrets.DEPLOY_KEY }}
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install nexo
      - run: nexo ci run main app.nexo --step build --yes
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: nexo-ci
          path: .nexo/ci
          include-hidden-files: true
          overwrite: true
  dev:
    runs-on: ubuntu-latest
    needs: [build]
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install nexo
      - uses: actions/download-artifact@v4
        with:
          name: nexo-ci
          path: .nexo/ci
      - run: nexo ci run main app.nexo --step dev --yes
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: nexo-ci
          path: .nexo/ci
          include-hidden-files: true
          overwrite: true
  prod:
    runs-on: ubuntu-latest
    needs: [dev]
    # approve: ana@company.com, luis@company.com
    environment: prod
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install nexo
      - uses: actions/download-artifact@v4
        with:
          name: nexo-ci
          path: .nexo/ci
      - run: nexo ci run main app.nexo --step prod --yes
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: nexo-ci
          path: .nexo/ci
          include-hidden-files: true
          overwrite: true
  after-success:
    runs-on: ubuntu-latest
    needs: [build, dev, prod]
    if: success()
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install nexo
      - uses: actions/download-artifact@v4
        with:
          name: nexo-ci
          path: .nexo/ci
      - run: nexo ci run main app.nexo --after success
  after-failure:
    runs-on: ubuntu-latest
    needs: [build, dev, prod]
    if: failure()
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install nexo
      - uses: actions/download-artifact@v4
        with:
          name: nexo-ci
          path: .nexo/ci
      - run: nexo ci run main app.nexo --after failure

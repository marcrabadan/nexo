// Generated by nexo ci export jenkins from app.nexo; do not edit.
pipeline {
    agent any
    environment {
        DEPLOY_KEY = credentials('DEPLOY_KEY')
    }
    stages {
        stage('setup') {
            steps { sh 'pip install nexo' }
        }
        stage('build') {
            when { anyOf { allOf { not { changeRequest() }; branch 'main' }; changeRequest() } }
            steps { sh 'nexo ci run main app.nexo --step build --yes' }
        }
        stage('dev') {
            when { anyOf { allOf { not { changeRequest() }; branch 'main' }; changeRequest() } }
            steps { sh 'nexo ci run main app.nexo --step dev --yes' }
        }
        stage('prod') {
            when { anyOf { allOf { not { changeRequest() }; branch 'main' }; changeRequest() } }
            input { message 'Approve the step prod'; submitter 'ana@company.com,luis@company.com' }
            steps { sh 'nexo ci run main app.nexo --step prod --yes' }
        }
    }
    post {
        success { sh 'nexo ci run main app.nexo --after success' }
        failure { sh 'nexo ci run main app.nexo --after failure' }
    }
}

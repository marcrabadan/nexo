# Generated by nexo ci export azure from app.nexo; do not edit.
trigger:
  branches:
    include:
      - 'main'
pr:
  branches:
    include:
      - '*'
pool:
  vmImage: ubuntu-latest
stages:
  - stage: build
    jobs:
      - job: build
        steps:
          - checkout: self
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install nexo
          - script: nexo ci run main app.nexo --step build --yes
            env:
              DEPLOY_KEY: $(DEPLOY_KEY)
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: .nexo/ci
              artifact: nexo-ci-build
  - stage: dev
    dependsOn: build
    jobs:
      - job: dev
        steps:
          - checkout: self
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install nexo
          - task: DownloadPipelineArtifact@2
            inputs:
              artifact: nexo-ci-build
              path: .nexo/ci
          - script: nexo ci run main app.nexo --step dev --yes
            env:
              DEPLOY_KEY: $(DEPLOY_KEY)
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: .nexo/ci
              artifact: nexo-ci-dev
  - stage: prod
    dependsOn: dev
    jobs:
      - job: approve
        pool: server
        steps:
          - task: ManualValidation@0
            inputs:
              notifyUsers: 'ana@company.com, luis@company.com'
              instructions: 'Approve the step prod'
      - job: prod
        dependsOn: approve
        steps:
          - checkout: self
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install nexo
          - task: DownloadPipelineArtifact@2
            inputs:
              artifact: nexo-ci-dev
              path: .nexo/ci
          - script: nexo ci run main app.nexo --step prod --yes
            env:
              DEPLOY_KEY: $(DEPLOY_KEY)
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: .nexo/ci
              artifact: nexo-ci-prod
  - stage: after_success
    dependsOn:
      - build
      - dev
      - prod
    condition: succeeded()
    jobs:
      - job: after_success
        steps:
          - checkout: self
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install nexo
          - task: DownloadPipelineArtifact@2
            inputs:
              artifact: nexo-ci-prod
              path: .nexo/ci
          - script: nexo ci run main app.nexo --after success
            env:
              DEPLOY_KEY: $(DEPLOY_KEY)
  - stage: after_failure
    dependsOn:
      - build
      - dev
      - prod
    condition: failed()
    jobs:
      - job: after_failure
        steps:
          - checkout: self
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install nexo
          - task: DownloadPipelineArtifact@2
            continueOnError: true
            inputs:
              artifact: nexo-ci-build
              path: .nexo/ci
          - task: DownloadPipelineArtifact@2
            continueOnError: true
            inputs:
              artifact: nexo-ci-dev
              path: .nexo/ci
          - task: DownloadPipelineArtifact@2
            continueOnError: true
            inputs:
              artifact: nexo-ci-prod
              path: .nexo/ci
          - script: nexo ci run main app.nexo --after failure
            env:
              DEPLOY_KEY: $(DEPLOY_KEY)

# Continuation lines and comments.
numbers = [3, -1, 4]
total = numbers
  |> where it > 0
  |> map it * 2  # doubled
  |> sum
print(total)
long = [1, 2,
    3,
    4
]
nested = {"a": [1,
    2],
    "b": [3]}
call = print(
    "one",
    "two")
fn f(x):
    # explains y
    y = x + 1  # one
    z = y      # two
    # end of f
    return z

print(f(1))  # trailing
text = """
   raw   text,
      kept"""
print(text)
# last

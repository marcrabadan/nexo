{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexo check diagnostics v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "position_encoding": {
      "const": "utf-16"
    },
    "success": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "required": [
    "schema_version",
    "position_encoding",
    "success",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "line",
        "character"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "character": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "properties": {
        "range": {
          "$ref": "#/$defs/range"
        },
        "newText": {
          "type": "string"
        }
      },
      "required": [
        "range",
        "newText"
      ],
      "additionalProperties": false
    },
    "fix": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "safe": {
          "type": "boolean"
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/edit"
          }
        }
      },
      "required": [
        "title",
        "safe",
        "edits"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/range"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "source": {
          "const": "nexo"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "required": [
            "fixes"
          ],
          "properties": {
            "fixes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fix"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "file",
        "range",
        "severity",
        "source",
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    }
  }
}

for i in 1..3:
    print(i)

repeat 2:
    print("again")

var n = 0
while n < 3:
    n += 1
print(n)

for word in ["a", "bb"]:
    if len(word) > 1:
        print("{word}: long")
    elif len(word) == 1:
        print("{word}: short")
    else:
        pass

print([x * x for x in range(1, 8) if x % 2 == 1])

try:
    write("notes.txt", "one\ntwo\n")
    print(read("notes.txt"))
    for line in read_lines("notes.txt"):
        print(line.upper())
    move_file("notes.txt", to: "archive/")
    print(len(read("archive/notes.txt")))
else e:
    print("could not use the file: {e.message}")

